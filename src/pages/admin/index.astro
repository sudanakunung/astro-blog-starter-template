  <!-- Main Content Layout -->
  <main class="container">
    <!-- ======================================================== -->
    <!-- TAB 1: PRODUCT CATALOG -->
    <!-- ======================================================== -->
    <div id="tab-products-content" class="tab-pane-grid">
      <!-- Left Column: Product Form & 2-Step Sync -->
      <section class="card">
        <div class="card-header">
          <div>
            <h2 id="form-title" class="card-title">Tambah / Edit Produk</h2>
            <p class="card-sub">Otomatis update ke D1 & memicu rebuild Astro</p>
          </div>
          <button id="btn-reset-form" type="button" class="btn-text">
            + Form Baru
          </button>
        </div>

        <form id="product-form" style="display: flex; flex-direction: column; gap: 0.875rem;">
          <input type="hidden" id="p-id" />

          <div class="form-grid">
            <div class="form-group col-span-2">
              <label class="form-label">Nama Produk <span style="color: #ef4444;">*</span></label>
              <input type="text" id="p-name" required placeholder="Contoh: Premium Linen Shirt" class="input-field" />
            </div>

            <div class="form-group">
              <label class="form-label">URL Slug (Auto) <span style="color: #ef4444;">*</span></label>
              <input type="text" id="p-slug" required placeholder="premium-linen-shirt" class="input-field input-mono" style="font-size: 0.75rem;" />
            </div>

            <div class="form-group">
              <label class="form-label">Status Produk</label>
              <select id="p-status" class="input-field">
                <option value="1">Aktif (Tampil di Toko)</option>
                <option value="0">Nonaktif (Sembunyikan)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Harga (Rupiah) <span style="color: #ef4444;">*</span></label>
              <div class="currency-wrap">
                <span class="currency-prefix">Rp</span>
                <input type="number" id="p-price" required min="0" placeholder="150000" class="input-field input-currency" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Stok Tersedia <span style="color: #ef4444;">*</span></label>
              <input type="number" id="p-stock" required min="0" placeholder="50" class="input-field input-mono" style="font-weight: 700;" />
            </div>

            <div class="form-group col-span-2">
              <label class="form-label">Berat (Gram) - Ongkir Biteship</label>
              <input type="number" id="p-weight" min="0" placeholder="250" class="input-field input-mono" />
            </div>

            <div class="form-group col-span-2">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;">
                <label class="form-label" style="margin-bottom: 0;">URL Foto Produk</label>
                <div style="display: flex; gap: 0.4rem; align-items: center;">
                  <button type="button" id="btn-gallery-pick-product" class="btn" style="padding: 0.2rem 0.55rem; font-size: 0.72rem; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; display: inline-flex; align-items: center; gap: 0.35rem; border-radius: 0.375rem; cursor: pointer; font-weight: 600;" title="Pilih foto/video dari koleksi galeri">
                    <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>Pilih dari Galeri</span>
                  </button>
                  <input type="file" id="p-image-file" accept="image/*,video/*" style="display: none;" />
                  <button type="button" id="btn-upload-p-image" class="btn" style="padding: 0.2rem 0.55rem; font-size: 0.72rem; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; display: inline-flex; align-items: center; gap: 0.35rem; border-radius: 0.375rem; cursor: pointer; font-weight: 600;">
                    <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    <span id="btn-upload-p-text">Upload MinIO</span>
                  </button>
                </div>
              </div>
              <input type="url" id="p-image" placeholder="https://minio.navanusa.com/... atau URL gambar" class="input-field input-mono" style="font-size: 0.75rem;" />
              <div id="image-preview-container" class="hidden" style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; background-color: #f8fafc; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
                <img id="image-preview" src="" alt="Preview" style="width: 3.5rem; height: 3.5rem; object-fit: cover; border-radius: 0.375rem; border: 1px solid #cbd5e1;" />
                <div style="font-size: 0.75rem; color: #64748b;">Preview Foto Produk</div>
              </div>
            </div>

            <div class="form-group col-span-2">
              <label class="form-label">Deskripsi Produk</label>
              <textarea id="p-desc" rows="3" placeholder="Deskripsi lengkap bahan, varian, ukuran..." class="input-field" style="font-size: 0.75rem; resize: vertical;"></textarea>
            </div>
          </div>

          <!-- Sync Button -->
          <div style="padding-top: 0.5rem; border-top: 1px solid #f1f5f9;">
