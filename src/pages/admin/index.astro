    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `toast-item ${type === 'error' ? 'toast-error' : ''}`;
      const icon = type === 'success' ? '✓' : '⚠️';
      toast.innerHTML = `<span>${icon}</span><span>${message}</span>`;
      toastContainer.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function generateUUID() {
      if (crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
      });
    }

    function generateSlug(text) {
      return text.toString().toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    }

    function updateLivePreviews() {
      const name = (tabCfgStoreName?.value || cfgStoreName?.value || currentConfig.store_name || 'Navanusa Jewellery').trim();
      const title = (tabCfgStoreTitle?.value || cfgStoreTitle?.value || currentConfig.store_title || `${name} - Nordic Minimalist Shop`).trim();
      if (previewNavbarName) previewNavbarName.textContent = name.toUpperCase();
      if (previewTabTitle) previewTabTitle.textContent = title;
    }

    function getThemeLabel(t) {
      if (t === 'kaufmann' || t === 'theme3') return 'Theme 3 (Susanne Kaufmann Skincare)';
      if (t === 'impulse' || t === 'theme2') return 'Theme 2 (Impulse Editorial)';
      return 'Theme 1 (Nordic Minimalist)';
    }

    function isVideoUrl(url) {
      if (!url) return false;
      const clean = url.split('?')[0].toLowerCase();
      return clean.endsWith('.mp4') || clean.endsWith('.webm') || clean.endsWith('.mov') || clean.endsWith('.ogg') || clean.endsWith('.mkv');
    }

    function updateMediaPreview(inputId) {
      const input = document.getElementById(inputId);
      const previewBox = document.getElementById('preview-box-' + inputId);
      if (!input || !previewBox) return;

      const url = input.value.trim();
      if (!url) {
        let defaultMsg = 'Menggunakan media default template';
        if (inputId.includes('nordic')) defaultMsg = 'Menggunakan gambar default Nordic (/model-jewelry-banner.jpg)';
        else if (inputId.includes('impulse-hero')) defaultMsg = 'Menggunakan foto default Hero Impulse';
        else if (inputId.includes('impulse-editorial')) defaultMsg = 'Menggunakan foto default Lookbook';
        else if (inputId.includes('impulse-closing')) defaultMsg = 'Menggunakan foto default Closing Banner';
        else if (inputId.includes('kaufmann-hero')) defaultMsg = 'Menggunakan video default lotion application';
        else if (inputId.includes('kaufmann-scent')) defaultMsg = 'Menggunakan video default serum dropper';
        else if (inputId.includes('kaufmann-story')) defaultMsg = 'Menggunakan video default indoor spa pool';

        previewBox.innerHTML = `
          <div class="theme-media-empty-preview">
            <span>🎬</span>
            <span>${defaultMsg}</span>
          </div>
        `;
        return;
      }

      if (isVideoUrl(url)) {
        previewBox.innerHTML = `
          <video src="${url}" autoplay muted loop playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
          <span style="position: absolute; bottom: 6px; right: 8px; font-size: 0.65rem; background: rgba(0,0,0,0.75); color: #38bdf8; padding: 2px 7px; border-radius: 4px; font-weight: 700; letter-spacing: 0.05em;">VIDEO LOOP</span>
        `;
      } else {
        previewBox.innerHTML = `
          <img src="${url}" alt="Preview Media" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='https://placehold.co/400x150?text=Preview+Gagal';" />
          <span style="position: absolute; bottom: 6px; right: 8px; font-size: 0.65rem; background: rgba(0,0,0,0.75); color: #ffffff; padding: 2px 7px; border-radius: 4px; font-weight: 700; letter-spacing: 0.05em;">FOTO</span>
        `;
      }
    }

    function loadThemeConfigToInputs(cfg) {
      if (!cfg) return;
      const ids = [
        ['theme-nordic-showcase', cfg.nordic?.showcase_media],
        ['theme-impulse-hero', cfg.impulse?.hero_media],
        ['theme-impulse-editorial', cfg.impulse?.editorial_media],
        ['theme-impulse-closing', cfg.impulse?.closing_media],
        ['theme-kaufmann-hero', cfg.kaufmann?.hero_video],
        ['theme-kaufmann-scent', cfg.kaufmann?.scent_video],
        ['theme-kaufmann-story', cfg.kaufmann?.story_video],
      ];

      ids.forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el) {
          el.value = val || '';
          updateMediaPreview(id);
        }
      });
    }

    function applyThemeUI(themeName) {
      const isKaufmann = (themeName === 'kaufmann' || themeName === 'theme3');
      const isImpulse = (themeName === 'impulse' || themeName === 'theme2');

      // 1. Top Navbar Buttons
      [navTheme1, navTheme2, navTheme3].forEach(btn => btn?.classList.remove('active'));
      if (isKaufmann) {
        navTheme3?.classList.add('active');
      } else if (isImpulse) {
        navTheme2?.classList.add('active');
      } else {
        navTheme1?.classList.add('active');
      }

      // 2. Tab 3 Pill Buttons
      [tabPillTheme1, tabPillTheme2, tabPillTheme3].forEach(btn => btn?.classList.remove('active'));
      if (isKaufmann) {
        tabPillTheme3?.classList.add('active');
      } else if (isImpulse) {
        tabPillTheme2?.classList.add('active');
      } else {
        tabPillTheme1?.classList.add('active');
      }

      // 3. Tab 3 Option Cards & Badges
      const updateCardBadge = (card, badge, isActive) => {
        if (!card) return;
        if (isActive) {
          card.classList.add('active');
          if (badge) {
            badge.textContent = '✓ SEDANG DIGUNAKAN';
            badge.style.background = '#000000';
            badge.style.color = '#ffffff';
          }
        } else {
          card.classList.remove('active');
          if (badge) {
            badge.textContent = 'Pilih Template';
            badge.style.background = '#e2e8f0';
            badge.style.color = '#475569';
          }
        }
      };

      updateCardBadge(themeCardNordic, badgeThemeNordic, !isImpulse && !isKaufmann);
      updateCardBadge(themeCardImpulse, badgeThemeImpulse, isImpulse);
      updateCardBadge(themeCardKaufmann, badgeThemeKaufmann, isKaufmann);

      // 4. Right Preview Mockup
      if (previewActiveThemeTitle) {
        previewActiveThemeTitle.textContent = isKaufmann
          ? 'Theme 3: Kaufmann Skincare & Beauty'
          : isImpulse
          ? 'Theme 2: Impulse Editorial'
          : 'Theme 1: Nordic Minimalist';
      }
      if (previewActiveThemeSub) {
        previewActiveThemeSub.textContent = isKaufmann
          ? 'Katalog skincare organik, video hero/spa ambient & scents terhubung langsung ke database D1.'
          : isImpulse
          ? 'Katalog fashion minimalis, editorial banner & quick view terhubung langsung ke database D1.'
          : 'Katalog perhiasan & hero carousel terhubung langsung ke database D1.';
      }

      // 5. Update Per-Theme Media Customizer visibility & Badge
      const themeMediaActiveBadge = document.getElementById('theme-media-active-badge');
      const groupNordic = document.getElementById('theme-media-group-nordic');
      const groupImpulse = document.getElementById('theme-media-group-impulse');
      const groupKaufmann = document.getElementById('theme-media-group-kaufmann');

      if (themeMediaActiveBadge) {
        themeMediaActiveBadge.textContent = isKaufmann ? 'Theme 3 (Susanne Kaufmann)' : isImpulse ? 'Theme 2 (Impulse)' : 'Theme 1 (Nordic)';
      }

      if (groupNordic) groupNordic.classList.toggle('hidden', isImpulse || isKaufmann);
      if (groupImpulse) groupImpulse.classList.toggle('hidden', !isImpulse);
      if (groupKaufmann) groupKaufmann.classList.toggle('hidden', !isKaufmann);
    }

    async function switchTheme(targetTheme) {
      const normalized = (targetTheme === 'kaufmann' || targetTheme === 'theme3')
        ? 'kaufmann'
        : (targetTheme === 'impulse' || targetTheme === 'theme2')
        ? 'impulse'
        : 'nordic';

      currentConfig.theme = normalized;
      saveConfig(currentConfig);
      applyThemeUI(normalized);

      const label = getThemeLabel(normalized);
      showToast(`Menerapkan ${label}...`, 'success');

      try {
        const base = (currentConfig.worker_url || window.location.origin).replace(/\/+$/, '');
        const res = await fetch(`${base}/api/store/theme`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            store_id: currentConfig.store_id || 'jewellery',
            theme: normalized
          })
        });

        const data = await res.json();
        if (data.ok) {
          showToast(`Berhasil! Toko sekarang menggunakan ${label}`, 'success');
        } else {
          showToast(data.error || 'Gagal menyimpan tema ke database', 'error');
        }
      } catch (err) {
        showToast('Tema aktif di lokal. (D1 sync offline: ' + err.message + ')', 'success');
      }
    }

    function loadConfig() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          currentConfig = { ...currentConfig, ...JSON.parse(saved) };
        }
      } catch (e) {
        console.warn('Failed to load local config:', e);
      }

      badgeStoreName.textContent = `Store: ${currentConfig.store_id || 'jewellery'} (${currentConfig.store_name || 'Navanusa Jewellery'})`;
      if (cfgStoreId) cfgStoreId.value = currentConfig.store_id || '';
      if (cfgStoreName) cfgStoreName.value = currentConfig.store_name || '';
      if (cfgStoreTitle) cfgStoreTitle.value = currentConfig.store_title || '';
      if (cfgWorkerUrl) cfgWorkerUrl.value = currentConfig.worker_url || window.location.origin;
      if (cfgToken) cfgToken.value = currentConfig.internal_token || '';
      if (cfgDeployHook) cfgDeployHook.value = currentConfig.deploy_hook_url || '';

      if (tabCfgStoreId) tabCfgStoreId.value = currentConfig.store_id || '';
      if (tabCfgStoreName) tabCfgStoreName.value = currentConfig.store_name || '';
      if (tabCfgStoreTitle) tabCfgStoreTitle.value = currentConfig.store_title || '';
      if (tabCfgWorkerUrl) tabCfgWorkerUrl.value = currentConfig.worker_url || window.location.origin;
      if (tabCfgToken) tabCfgToken.value = currentConfig.internal_token || '';
      if (tabCfgDeployHook) tabCfgDeployHook.value = currentConfig.deploy_hook_url || '';

      updateLivePreviews();
      applyThemeUI(currentConfig.theme || 'nordic');
      if (currentConfig.theme_config) {
        loadThemeConfigToInputs(currentConfig.theme_config);
      }
    }

    function saveConfig(cfg) {
      currentConfig = { ...currentConfig, ...cfg };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(currentConfig));
      badgeStoreName.textContent = `Store: ${currentConfig.store_id || 'jewellery'} (${currentConfig.store_name || 'Navanusa Jewellery'})`;
    }

    async function fetchStoreSettingsFromD1() {
      try {
        const base = (currentConfig.worker_url || window.location.origin).replace(/\/+$/, '');
        const res = await fetch(`${base}/api/store/settings?store_id=${encodeURIComponent(currentConfig.store_id || 'jewellery')}`);
        if (res.ok) {
          const data = await res.json();
          if (data.ok) {
            if (data.name) {
              currentConfig.store_name = data.name;
              if (cfgStoreName) cfgStoreName.value = data.name;
              if (tabCfgStoreName) tabCfgStoreName.value = data.name;
            }
            if (data.title) {
              currentConfig.store_title = data.title;
              if (cfgStoreTitle) cfgStoreTitle.value = data.title;
              if (tabCfgStoreTitle) tabCfgStoreTitle.value = data.title;
            }
            if (data.theme) {
              currentConfig.theme = data.theme;
              applyThemeUI(data.theme);
            }
            if (data.theme_config) {
              currentConfig.theme_config = data.theme_config;
              loadThemeConfigToInputs(data.theme_config);
            }
            saveConfig(currentConfig);
            updateLivePreviews();
          }
        }
      } catch (e) {
        console.warn('Could not fetch store settings from D1:', e);
      }
    }

    async function saveStoreSettingsToD1(newCfg) {
      saveConfig(newCfg);
      updateLivePreviews();

      try {
        const base = (newCfg.worker_url || window.location.origin).replace(/\/+$/, '');
        const headers = { 'Content-Type': 'application/json' };
        if (newCfg.internal_token) {
          headers['Authorization'] = `Bearer ${newCfg.internal_token}`;
        }

        const res = await fetch(`${base}/api/store/settings`, {
          method: 'POST',
          headers,
          body: JSON.stringify({
            store_id: newCfg.store_id,
            name: newCfg.store_name,
            title: newCfg.store_title,
            theme: newCfg.theme || currentConfig.theme || 'nordic',
            theme_config: newCfg.theme_config || currentConfig.theme_config || {},
          })
        });

        const data = await res.json();
        if (data.ok) {
          showToast('Nama toko, title & template berhasil disimpan ke database D1!', 'success');
        } else {
          showToast(data.error || 'Gagal menyimpan ke D1 (tersimpan di lokal)', 'error');
        }
      } catch (err) {
        showToast('Tersimpan di lokal. (D1 offline: ' + err.message + ')', 'success');
      }
    }

