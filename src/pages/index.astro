---
export const prerender = false; // SSR di Cloudflare Workers

import ShopLayout from '../layouts/ShopLayout.astro';
import HomeNordic from '../templates/HomeNordic.astro';
import HomeImpulse from '../templates/HomeImpulse.astro';
import HomeKaufmann from '../templates/HomeKaufmann.astro';
import { getActiveProducts } from '../lib/db/productRepo';
import { getActiveBanners } from '../lib/db/bannerRepo';
import type { D1Product, Store } from '../types/d1';
import type { CarouselSlide } from '../types/store';

// 1. Dapatkan tenant store dari locals (diisi oleh middleware) atau fallback default
const store: Store = Astro.locals.store || {
  id: 'jewellery',
  name: 'IMPULSE',
  title: 'Impulse - Minimalist Editorial Fashion',
  domain: 'localhost',
  theme: 'impulse',
  status: 'active',
  created_at: 0,
  updated_at: 0,
};

// 2. Query katalog produk & banner carousel tenant dari D1
const db = Astro.locals.runtime?.env?.DB;
let products: D1Product[] = [];
let slides: CarouselSlide[] = [];

if (db) {
  products = await getActiveProducts(db, store.id);
  slides = await getActiveBanners(db, store.id);
} else {
  products = await getActiveProducts();
  slides = await getActiveBanners();
}

// 3. Dynamic Theme Detection: Query param ?theme=kaufmann | ?theme=impulse | ?theme=nordic | store.theme
const url = new URL(Astro.request.url);
const themeParam = url.searchParams.get('theme')?.toLowerCase();
const activeTheme = themeParam || store.theme || 'nordic';
const isImpulse = activeTheme === 'impulse' || activeTheme === 'theme2';
const isKaufmann = activeTheme === 'kaufmann' || activeTheme === 'theme3';

// 4. Parse themeConfig from store.theme_config
let themeConfig: Record<string, any> = {};
if (store.theme_config) {
  try {
    themeConfig = typeof store.theme_config === 'string' ? JSON.parse(store.theme_config) : store.theme_config;
  } catch (e) {
    themeConfig = {};
  }
}
---

<ShopLayout
  title={
    isKaufmann
      ? (store.title || `${store.name || 'SUSANNE KAUFMANN'} — Holistic Skincare & Spa Rituals`)
      : isImpulse
      ? (store.title || 'IMPULSE — Minimalist Editorial Fashion')
      : (store.title || `${store.name} - Nordic Minimalist Shop`)
  }
  description={
    isKaufmann
      ? 'Organic alpine botanicals, targeted natural active ingredients and sensory body rituals.'
      : isImpulse
      ? 'Warm neutral, timeless silhouettes and minimalist fashion editorial collection.'
      : `Katalog belanja online di ${store.name}`
  }
  storeName={store.name}
  hideNavbar={isImpulse || isKaufmann}
  hideFooter={isImpulse || isKaufmann}
>
  {isKaufmann ? (
    <HomeKaufmann
      brandName={store.name || 'SUSANNE KAUFMANN'}
      dbProducts={products}
      slides={slides}
      themeConfig={themeConfig?.kaufmann || {}}
    />
  ) : isImpulse ? (
    <HomeImpulse
      brandName={store.name || 'IMPULSE'}
      dbProducts={products}
      slides={slides}
      themeConfig={themeConfig?.impulse || {}}
    />
  ) : (
    <HomeNordic
      products={products}
      slides={slides}
      themeConfig={themeConfig?.nordic || {}}
    />
  )}
</ShopLayout>
