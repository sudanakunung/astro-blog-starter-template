---
export const prerender = false; // SSR di Cloudflare Workers

import ShopLayout from '../layouts/ShopLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProductGrid from '../components/ProductGrid.astro';
import AboutSection from '../components/AboutSection.astro';
import { getActiveProducts } from '../lib/db/productRepo';
import { carouselSlides } from '../data/storeData';
import type { D1Product, Store } from '../types/d1';

// 1. Dapatkan tenant store dari locals (diisi oleh middleware) atau fallback default
const store: Store = Astro.locals.store || {
  id: 'navanusa',
  name: 'Navanusa Store',
  domain: 'localhost',
  status: 'active',
  created_at: 0,
  updated_at: 0,
};

// 2. Query katalog produk tenant dari D1
const db = Astro.locals.runtime?.env?.DB;
let products: D1Product[] = [];

if (db) {
  products = await getActiveProducts(db, store.id);
}
---

<ShopLayout
  title={`${store.name} - Nordic Minimalist Shop`}
  description={`Katalog belanja online di ${store.name}`}
  storeName={store.name}
>
  <!-- Hero Carousel -->
  <HeroCarousel slides={carouselSlides} />

  <!-- Product Catalog Grid -->
  <ProductGrid products={products} title="Katalog Produk" />

  <!-- About Section -->
  <AboutSection title="About" />
</ShopLayout>
