---
export const prerender = false; // SSR di Cloudflare Workers

import ShopLayout from '../layouts/ShopLayout.astro';
import HomeNordic from '../templates/HomeNordic.astro';
import HomeImpulse from '../templates/HomeImpulse.astro';
import { getActiveProducts } from '../lib/db/productRepo';
import { getActiveBanners } from '../lib/db/bannerRepo';
import type { D1Product, Store } from '../types/d1';
import type { CarouselSlide } from '../types/store';

// 1. Dapatkan tenant store dari locals (diisi oleh middleware) atau fallback default
const store: Store = Astro.locals.store || {
  id: 'jewellery',
  name: 'IMPULSE',
  title: 'Impulse - Minimalist Editorial Fashion',
  domain: 'localhost',
  theme: 'impulse',
  status: 'active',
  created_at: 0,
  updated_at: 0,
};

// 2. Query katalog produk & banner carousel tenant dari D1
const db = Astro.locals.runtime?.env?.DB;
let products: D1Product[] = [];
let slides: CarouselSlide[] = [];

if (db) {
  products = await getActiveProducts(db, store.id);
  slides = await getActiveBanners(db, store.id);
} else {
  products = await getActiveProducts();
  slides = await getActiveBanners();
}

// 3. Dynamic Theme Detection: Query param ?theme=impulse | ?theme=nordic | store.theme
const url = new URL(Astro.request.url);
const themeParam = url.searchParams.get('theme')?.toLowerCase();
const activeTheme = themeParam || store.theme || 'nordic';
const isImpulse = activeTheme === 'impulse' || activeTheme === 'theme2';
---

<ShopLayout
  title={isImpulse ? (store.title || 'IMPULSE — Minimalist Editorial Fashion') : (store.title || `${store.name} - Nordic Minimalist Shop`)}
  description={isImpulse ? 'Warm neutral, timeless silhouettes and minimalist fashion editorial collection.' : `Katalog belanja online di ${store.name}`}
  storeName={store.name}
  hideNavbar={isImpulse}
  hideFooter={isImpulse}
>
  {isImpulse ? (
    <HomeImpulse brandName={store.name || 'IMPULSE'} dbProducts={products} slides={slides} />
  ) : (
    <HomeNordic products={products} slides={slides} />
  )}
</ShopLayout>
