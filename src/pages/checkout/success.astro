---
import ShopLayout from '../../layouts/ShopLayout.astro';

export const prerender = false;

const url = Astro.url;
const orderId = url.searchParams.get('order_id') || 'ORD-SAMPLE';
const total = url.searchParams.get('total') || '0';
const name = url.searchParams.get('name') || 'Pelanggan Setia';
const method = url.searchParams.get('method') || 'qris';
const phone = url.searchParams.get('phone') || '';
const paymentUrl = url.searchParams.get('payment_url') || '';

function formatIDR(amount: number) {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
  }).format(amount);
}

const formattedTotal = formatIDR(Number(total) || 0);

const paymentTitles: Record<string, string> = {
  qris: 'QRIS / E-Wallet (Mayar Gateway)',
  va: 'Virtual Account (Bank Transfer)',
  cod: 'Cash On Delivery (COD / Bayar di Tempat)',
};

const paymentInstruction: Record<string, string> = {
  qris: 'Silakan scan QRIS di bawah menggunakan aplikasi BCA, GoPay, OVO, Dana, atau ShopeePay untuk menyelesaikan pembayaran secara instan.',
  va: 'Silakan transfer ke nomor Virtual Account yang telah dikirimkan ke nomor WhatsApp Anda.',
  cod: 'Pesanan Anda sedang dipersiapkan dan akan dikirim. Siapkan uang pas saat kurir tiba di alamat Anda.',
};
---

<ShopLayout title={`Pesanan Berhasil | ${Astro.locals.store?.name || 'Navanusa Jewellery'}`}>
  <div class="bg-gray-50 min-h-[calc(100vh-140px)] py-12 md:py-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
      
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sm:p-10 text-center">
        
        <!-- Success Icon -->
        <div class="w-16 h-16 bg-green-50 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider mb-3">
          Pesanan Berhasil Dibuat
        </span>

        <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-wider text-gray-900 mb-2">
          Terima Kasih, {name}!
        </h1>
        <p class="text-sm text-gray-500 max-w-md mx-auto mb-8">
          Pesanan Anda telah kami terima dengan ID <strong class="text-gray-900 font-mono font-bold">{orderId}</strong>.
        </p>

        <!-- Order Detail Card -->
        <div class="bg-gray-50 rounded-lg p-5 text-left border border-gray-100 space-y-3 mb-8">
          <div class="flex justify-between items-center text-xs text-gray-500 uppercase tracking-wider">
            <span>Nomor Pesanan</span>
            <span class="font-mono font-bold text-gray-900 text-sm">{orderId}</span>
          </div>
          <div class="flex justify-between items-center text-xs text-gray-500 uppercase tracking-wider">
            <span>Metode Pembayaran</span>
            <span class="font-semibold text-gray-900">{paymentTitles[method] || method.toUpperCase()}</span>
          </div>
          <div class="flex justify-between items-center text-xs text-gray-500 uppercase tracking-wider border-t border-gray-200 pt-3">
            <span class="font-semibold text-gray-700">Total Pembayaran</span>
            <span class="font-bold text-black text-lg">{formattedTotal}</span>
          </div>
        </div>

        <!-- Payment Instructions / Mayar Real or QRIS Mock -->
        {method === 'qris' && paymentUrl && (
          <div class="bg-gradient-to-r from-purple-50 to-indigo-50 border border-purple-200 rounded-xl p-6 mb-8 text-center shadow-sm">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 mb-3">
              ⚡ Pembayaran Online Mayar.id
            </span>
            <h3 class="text-base font-bold text-gray-900 mb-2">Selesaikan Pembayaran Sekarang</h3>
            <p class="text-xs text-gray-600 max-w-md mx-auto mb-5">
              Klik tombol di bawah untuk membuka halaman pembayaran resmi Mayar dan membayar via QRIS, GoPay, OVO, Dana, atau ShopeePay.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a
                href={paymentUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center space-x-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold text-sm px-8 py-3.5 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
              >
                <span>Bayar Sekarang via Mayar</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
            <p class="text-[11px] text-gray-400 mt-3">Status pesanan Anda akan otomatis diperbarui begitu pembayaran selesai diverifikasi.</p>
          </div>
        )}

        {method === 'qris' && !paymentUrl && (
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-8 text-center shadow-sm">
            <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
              💳
            </div>
            <h3 class="text-sm font-bold text-gray-900 mb-1">Menunggu QRIS / Tautan Pembayaran Resmi</h3>
            <p class="text-xs text-gray-600 max-w-md mx-auto mb-4 leading-relaxed">
              Pesanan Anda telah berhasil dibuat dengan status <span class="font-semibold text-amber-800">Menunggu Pembayaran</span>. Silakan klik tombol di bawah untuk meminta kode QRIS resmi atau informasi rekening ke admin toko.
            </p>
            <div class="flex justify-center">
              <a
                href={`https://wa.me/6281234567890?text=Halo%20Admin,%20saya%20sudah%20checkout%20Order%20ID%20${orderId}%20sebesar%20${encodeURIComponent(formattedTotal)}.%20Mohon%20kirimkan%20QRIS%20resmi%20pembayaran.`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs uppercase tracking-wider font-bold px-6 py-3 rounded-lg shadow transition-colors"
              >
                <span>Konfirmasi & Minta QRIS via WhatsApp</span>
              </a>
            </div>
          </div>
        )}

        {method !== 'qris' && (
          <div class="bg-blue-50 border border-blue-200 text-blue-900 rounded-lg p-4 mb-8 text-sm text-left">
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="font-semibold mb-0.5">Petunjuk Pembayaran</p>
                <p class="text-xs text-blue-800 leading-relaxed">{paymentInstruction[method] || 'Silakan ikuti instruksi pembayaran.'}</p>
              </div>
            </div>
          </div>
        )}

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href="/" 
            class="bg-black text-white px-8 py-3 text-xs uppercase tracking-wider font-semibold rounded hover:bg-gray-800 transition-colors"
          >
            Lanjut Berbelanja
          </a>
          {phone && (
            <a 
              href={`https://wa.me/6281234567890?text=Halo%20Admin%20NORDICS,%20saya%20sudah%20melakukan%20checkout%20dengan%20Order%20ID%20${orderId}`} 
              target="_blank"
              rel="noopener noreferrer"
              class="border border-gray-300 text-gray-800 px-6 py-3 text-xs uppercase tracking-wider font-semibold rounded hover:bg-gray-50 transition-colors inline-flex items-center justify-center space-x-2"
            >
              <span>Konfirmasi via WhatsApp</span>
            </a>
          )}
        </div>

      </div>

    </div>
  </div>
</ShopLayout>

<script is:inline>
  // Ensure local cart is cleared when visiting success page
  try {
    localStorage.removeItem('nordic_cart_items');
  } catch (e) {}
</script>
