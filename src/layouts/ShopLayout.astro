---
import Navbar from '../components/Navbar.astro';
import ShopFooter from '../components/ShopFooter.astro';
import CartDrawer from '../components/CartDrawer.astro';
import WishlistDrawer from '../components/WishlistDrawer.astro';
import Toast from '../components/Toast.astro';
import BackToTop from '../components/BackToTop.astro';
import type { Store } from '../types/d1';

interface Props {
  title?: string;
  description?: string;
  storeName?: string;
  hideNavbar?: boolean;
  hideFooter?: boolean;
}

const currentStore: Store | undefined = Astro.locals.store;
const defaultStoreName = currentStore?.name || 'Navanusa Jewellery';
const defaultPageTitle = currentStore?.title || `${defaultStoreName} - Nordic Minimalist Shop`;

const {
  title = defaultPageTitle,
  description = `Platform multi-tenant toko online minimalis di ${defaultStoreName}`,
  storeName = defaultStoreName,
  hideNavbar = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="tailwind,tailwindcss,tailwind css,css,starter template,free template,store template, shop layout, minimal, monochrome, minimalistic, theme, nordic"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="https://unpkg.com/tailwindcss@2.2.19/dist/tailwind.min.css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:200,400,500,600,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />

    <style is:global>
      .work-sans {
        font-family: 'Work Sans', sans-serif;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, Cambria, serif;
      }
      .hover\:grow {
        transition: all 0.3s;
        transform: scale(1);
      }
      .hover\:grow:hover {
        transform: scale(1.02);
      }
    </style>
  </head>

  <body class="bg-white text-gray-600 work-sans leading-normal text-base tracking-normal flex flex-col min-h-screen">
    {!hideNavbar && <Navbar storeName={storeName} />}
    
    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && <ShopFooter />}

    <!-- Interactive Global Drawers & Toast Notifications -->
    <CartDrawer />
    <WishlistDrawer />
    <Toast />
    <BackToTop />

    <script is:inline>
      // Sinkronisasi client-side otomatis jika ada konfigurasi terbaru di localStorage
      try {
        const saved = localStorage.getItem('astro_sync_config');
        if (saved) {
          const cfg = JSON.parse(saved);
          if (cfg.store_name) {
            const brandEl = document.getElementById('navbar-brand-name');
            if (brandEl && (!brandEl.dataset.customized || brandEl.textContent.trim() === 'NORDICS')) {
              brandEl.textContent = cfg.store_name;
            }
          }
          if (cfg.store_title && document.title.includes('Nordic Minimalist Shop')) {
            document.title = cfg.store_title;
          }
        }
      } catch (e) {}
    </script>
  </body>
</html>
