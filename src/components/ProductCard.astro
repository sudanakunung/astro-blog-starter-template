---
import type { D1Product } from '../types/d1';
import { formatRupiah } from '../lib/utils/currency';

interface Props {
  product: D1Product;
}

const { product } = Astro.props;
const fallbackImage = 'https://images.unsplash.com/photo-1555982105-d25af4182e4e?auto=format&fit=crop&w=400&h=400&q=80';
---

<div class="w-full md:w-1/3 xl:w-1/4 p-6 flex flex-col group/card">
  <div class="relative overflow-hidden bg-gray-100 aspect-square flex items-center justify-center">
    <a href={`/products/${product.slug}`} class="w-full h-full block overflow-hidden">
      <img
        class="hover:grow hover:shadow-lg w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
        src={product.image_url || fallbackImage}
        alt={product.name}
        loading="lazy"
      />
    </a>

    <!-- Wishlist Button Overlay -->
    <button
      type="button"
      aria-label={`Tambah ${product.name} ke wishlist`}
      class="wishlist-toggle-btn absolute top-3 right-3 p-2 bg-white/80 hover:bg-white rounded-full shadow-sm text-gray-500 hover:text-red-500 transition-all focus:outline-none z-10"
      data-product-id={product.id}
      data-product-name={product.name}
      data-product-price={product.price}
      data-product-image={product.image_url || fallbackImage}
      data-product-slug={product.slug}
      data-product-stock={product.stock}
    >
      <svg class="h-5 w-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>

    <!-- Quick Add To Cart Button on Card Hover -->
    <button
      type="button"
      class="quick-add-cart-btn absolute bottom-0 inset-x-0 bg-black/90 text-white text-xs uppercase tracking-wider py-2.5 font-medium transform translate-y-full group-hover/card:translate-y-0 transition-transform duration-200 text-center hover:bg-black"
      data-product-id={product.id}
      data-product-name={product.name}
      data-product-price={product.price}
      data-product-image={product.image_url || fallbackImage}
      data-product-slug={product.slug}
      data-product-stock={product.stock}
    >
      + Tambah ke Keranjang
    </button>
  </div>

  <div class="pt-3 flex items-center justify-between">
    <a href={`/products/${product.slug}`} class="text-gray-900 group-hover/card:underline font-medium truncate block">
      {product.name}
    </a>
  </div>

  <div class="flex items-center justify-between pt-1">
    <p class="text-gray-900 font-semibold">{formatRupiah(product.price)}</p>
    <span class="text-[11px] text-gray-400">Stok: {product.stock}</span>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Quick Add to Cart
    document.querySelectorAll('.quick-add-cart-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const product = {
          id: btn.getAttribute('data-product-id'),
          name: btn.getAttribute('data-product-name'),
          price: parseInt(btn.getAttribute('data-product-price') || '0', 10),
          image: btn.getAttribute('data-product-image'),
          slug: btn.getAttribute('data-product-slug'),
          stock: parseInt(btn.getAttribute('data-product-stock') || '99', 10),
        };
        window.NordicCart?.addItem(product, 1);
      });
    });

    // Wishlist Toggle
    document.querySelectorAll('.wishlist-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const product = {
          id: btn.getAttribute('data-product-id'),
          name: btn.getAttribute('data-product-name'),
          price: parseInt(btn.getAttribute('data-product-price') || '0', 10),
          image: btn.getAttribute('data-product-image'),
          slug: btn.getAttribute('data-product-slug'),
          stock: parseInt(btn.getAttribute('data-product-stock') || '99', 10),
        };
        window.NordicWishlist?.toggleItem(product);
      });
    });
  });
</script>
