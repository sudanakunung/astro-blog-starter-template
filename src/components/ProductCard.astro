---
import type { D1Product } from '../types/d1';
import { formatRupiah } from '../lib/utils/currency';

interface Props {
  product: D1Product;
}

const { product } = Astro.props;
const fallbackImage = 'https://images.unsplash.com/photo-1555982105-d25af4182e4e?auto=format&fit=crop&w=400&h=400&q=80';
---

<div class="w-full flex flex-col h-full bg-white rounded-xl overflow-hidden border border-gray-100 hover:border-gray-200 hover:shadow-md transition-all duration-300 group/card">
  <!-- Square Image Box with Strict Aspect Ratio 1:1 -->
  <div class="relative w-full aspect-square overflow-hidden bg-gray-50 flex items-center justify-center flex-shrink-0" style="aspect-ratio: 1 / 1;">
    <a href={`/products/${product.slug}`} class="w-full h-full block">
      <img
        class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-105"
        src={product.image_url || fallbackImage}
        alt={product.name}
        loading="lazy"
        style="aspect-ratio: 1 / 1; object-fit: cover; width: 100%; height: 100%;"
      />
    </a>

    <!-- Quick Add To Cart Button on Card Hover -->
    <button
      type="button"
      class="quick-add-cart-btn absolute bottom-0 inset-x-0 bg-gray-900/90 hover:bg-gray-900 backdrop-blur-sm text-white text-[11px] uppercase tracking-wider py-2.5 font-semibold transform translate-y-full group-hover/card:translate-y-0 transition-transform duration-200 text-center"
      data-product-id={product.id}
      data-product-name={product.name}
      data-product-price={product.price}
      data-product-image={product.image_url || fallbackImage}
      data-product-slug={product.slug}
      data-product-stock={product.stock}
    >
      + Tambah ke Keranjang
    </button>
  </div>

  <!-- Product Details -->
  <div class="p-4 flex flex-col flex-1 justify-between gap-2">
    <!-- Nama produk + tombol wishlist sejajar di ujung kanan -->
    <div class="flex items-start justify-between gap-2">
      <a href={`/products/${product.slug}`} class="text-gray-900 group-hover/card:text-indigo-600 font-semibold text-sm line-clamp-2 flex-1 transition-colors leading-snug" title={product.name}>
        {product.name}
      </a>
      <!-- Wishlist Button — sejajar nama, ujung kanan -->
      <button
        type="button"
        aria-label={`Tambah ${product.name} ke wishlist`}
        class="wishlist-toggle-btn flex-shrink-0 p-1.5 bg-white rounded-full shadow-sm border border-gray-200 hover:scale-110 transition-all duration-200 focus:outline-none"
        data-product-id={product.id}
        data-product-name={product.name}
        data-product-price={product.price}
        data-product-image={product.image_url || fallbackImage}
        data-product-slug={product.slug}
        data-product-stock={product.stock}
      >
        <svg class="wishlist-icon h-4 w-4 fill-none stroke-current text-gray-400 transition-colors" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </button>
    </div>

    <div class="flex items-center justify-between pt-2 border-t border-gray-50 mt-auto">
      <p class="text-gray-900 font-bold text-sm">{formatRupiah(product.price)}</p>
      <span class="text-[11px] text-gray-400 font-medium">Stok: {product.stock}</span>
    </div>
  </div>
</div>

<script is:inline>
  // GUARD: script ini dirender sekali per ProductCard, tapi handler harus didaftarkan hanya SEKALI.
  // Tanpa guard ini: 8 produk = 8 click handler = toggleItem dipanggil 8x per klik!
  if (!window._nwcInit) {
    window._nwcInit = true;

    // Helper: update visual state tombol wishlist
    window._syncWishBtnIcon = function (btn, isActive) {
      const icon = btn.querySelector('.wishlist-icon, svg');
      if (!icon) return;
      if (isActive) {
        icon.classList.add('fill-current', 'text-red-500');
        icon.classList.remove('fill-none', 'text-gray-400');
        btn.classList.add('border-red-200', 'bg-red-50');
        btn.classList.remove('border-gray-200', 'bg-white');
      } else {
        icon.classList.remove('fill-current', 'text-red-500');
        icon.classList.add('fill-none', 'text-gray-400');
        btn.classList.remove('border-red-200', 'bg-red-50');
        btn.classList.add('border-gray-200', 'bg-white');
      }
    };

    // Helper: sync semua tombol wishlist di halaman dari localStorage
    window._syncAllWishIcons = function () {
      try {
        const items = JSON.parse(localStorage.getItem('nordic_wishlist_items') || '[]');
        document.querySelectorAll('.wishlist-toggle-btn').forEach(function (btn) {
          const id = btn.getAttribute('data-product-id');
          window._syncWishBtnIcon(btn, items.some(function (i) { return i.id === id; }));
        });
      } catch (e) {}
    };

    // Event delegation: satu handler untuk semua tombol di halaman
    document.addEventListener('click', function (e) {
      // Quick Add to Cart
      const cartBtn = e.target.closest('.quick-add-cart-btn');
      if (cartBtn) {
        e.preventDefault();
        e.stopPropagation();
        window.NordicCart?.addItem({
          id: cartBtn.getAttribute('data-product-id'),
          name: cartBtn.getAttribute('data-product-name'),
          price: parseInt(cartBtn.getAttribute('data-product-price') || '0', 10),
          image: cartBtn.getAttribute('data-product-image'),
          slug: cartBtn.getAttribute('data-product-slug'),
          stock: parseInt(cartBtn.getAttribute('data-product-stock') || '99', 10),
        }, 1);
        return;
      }

      // Wishlist Toggle — hanya satu kali per klik!
      const wishBtn = e.target.closest('.wishlist-toggle-btn');
      if (wishBtn) {
        e.preventDefault();
        e.stopPropagation();
        if (!window.NordicWishlist) return;
        const product = {
          id: wishBtn.getAttribute('data-product-id'),
          name: wishBtn.getAttribute('data-product-name'),
          price: parseInt(wishBtn.getAttribute('data-product-price') || '0', 10),
          image: wishBtn.getAttribute('data-product-image'),
          slug: wishBtn.getAttribute('data-product-slug'),
          stock: parseInt(wishBtn.getAttribute('data-product-stock') || '99', 10),
        };
        const isNowActive = window.NordicWishlist.toggleItem(product);
        // Update icon langsung di tombol yang diklik
        window._syncWishBtnIcon(wishBtn, isNowActive);
        return;
      }
    });

    // Sync semua icon saat wishlist berubah (misalnya item dihapus dari drawer)
    window.addEventListener('nordic:wishlist-updated', window._syncAllWishIcons);
  }

  // Sync icon selalu dijalankan (termasuk untuk kartu yang baru dimuat)
  window._syncAllWishIcons && window._syncAllWishIcons();
</script>
