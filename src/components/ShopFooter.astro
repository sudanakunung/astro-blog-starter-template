---
import type { Store } from '../types/d1';

const currentStore: Store | undefined = Astro.locals.store;
const brandName = currentStore?.name || 'NORDICS';
---

<footer class="bg-white text-neutral-600 pt-14 pb-10 border-t border-gray-200">
  <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-12">

    <!-- Top 4 Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-gray-200">

      <!-- Col 1: SHOP -->
      <div class="lg:col-span-2 footer-accordion-group">
        <button class="w-full flex justify-between items-center text-left md:pointer-events-none pb-2 md:pb-0 focus:outline-none">
          <h4 class="text-xs tracking-widest uppercase font-bold text-gray-900">SHOP</h4>
          <span class="md:hidden text-gray-400 transform transition-transform accordion-chevron">+</span>
        </button>
        <ul class="mt-4 space-y-2.5 text-xs text-gray-500 tracking-wider hidden md:block accordion-content">
          <li><a href="#" class="hover:text-black transition-colors">New Arrivals</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Best Sellers</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Dresses</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Tees &amp; Tops</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Linen Collection</a></li>
          <li><a href="#" class="hover:text-rose-600 transition-colors">Sale</a></li>
        </ul>
      </div>

      <!-- Col 2: THE COMPANY -->
      <div class="lg:col-span-3 footer-accordion-group">
        <button class="w-full flex justify-between items-center text-left md:pointer-events-none pb-2 md:pb-0 focus:outline-none">
          <h4 class="text-xs tracking-widest uppercase font-bold text-gray-900">Our Story</h4>
          <span class="md:hidden text-gray-400 transform transition-transform accordion-chevron">+</span>
        </button>
        <ul class="mt-4 space-y-2.5 text-xs text-gray-500 tracking-wider hidden md:block accordion-content">
          <li><a href="#" class="hover:text-black transition-colors">Sustainability &amp; Ethics</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Careers</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Brand Values</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Press &amp; Features</a></li>
        </ul>
      </div>

      <!-- Col 3: GET HELP -->
      <div class="lg:col-span-3 footer-accordion-group">
        <button class="w-full flex justify-between items-center text-left md:pointer-events-none pb-2 md:pb-0 focus:outline-none">
          <h4 class="text-xs tracking-widest uppercase font-bold text-gray-900">GET HELP</h4>
          <span class="md:hidden text-gray-400 transform transition-transform accordion-chevron">+</span>
        </button>
        <ul class="mt-4 space-y-2.5 text-xs text-gray-500 tracking-wider hidden md:block accordion-content">
          <li><a href="#" class="hover:text-black transition-colors">FAQ</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Shipping &amp; 30-Day Returns</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Size Guide &amp; Fit</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Contact Support</a></li>
          <li><a href="#" class="hover:text-black transition-colors">Digital Gift Cards</a></li>
        </ul>
      </div>

      <!-- Col 4: NEWSLETTER -->
      <div class="lg:col-span-4">
        <p class="text-xs text-gray-500 leading-relaxed font-light">
          Be the first to know about our biggest and best sales. We'll never send more than one email a month.
        </p>

        <!-- Email Signup Form -->
        <form id="nordic-newsletter-form" class="mt-5 flex items-stretch gap-2">
          <input
            type="email"
            id="nordic-newsletter-email"
            placeholder="Enter your email address"
            required
            class="flex-1 bg-white text-gray-900 placeholder-gray-400 border border-gray-300 px-4 py-3 rounded-full text-xs focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-all"
          />
          <button
            type="submit"
            class="bg-black text-white hover:bg-gray-800 px-5 py-3 rounded-full text-xs font-bold tracking-widest uppercase transition-colors shrink-0"
          >
            SUBSCRIBE
          </button>
        </form>
        <p id="nordic-newsletter-success" class="hidden text-xs text-emerald-600 mt-2">
          Thank you for subscribing!
        </p>
      </div>

    </div>

    <!-- Bottom Bar: Social Icons + Copyright -->
    <div class="mt-8 flex flex-col md:flex-row items-center justify-between text-xs text-gray-400 space-y-4 md:space-y-0">

      <!-- Social Media Icons -->
      <div class="flex items-center space-x-5 text-gray-500">
        <a href="https://instagram.com" target="_blank" rel="noopener" class="hover:text-black transition-colors" title="Instagram">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener" class="hover:text-black transition-colors" title="Facebook">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
        </a>
        <a href="https://pinterest.com" target="_blank" rel="noopener" class="hover:text-black transition-colors" title="Pinterest">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.334 1.357-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 12-5.373 12-12 0-6.628-5.393-12-12-12z"/></svg>
        </a>
        <a href="https://tiktok.com" target="_blank" rel="noopener" class="hover:text-black transition-colors" title="TikTok">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.18 1.19 2.12 2.38 2.36.95.2 1.96.06 2.76-.47.66-.43 1.12-1.12 1.25-1.9.07-.76.04-1.53.04-2.3V.02z"/></svg>
        </a>
      </div>

      <!-- Copyright -->
      <div class="flex items-center space-x-4">
        <span>&copy; {new Date().getFullYear()} {brandName}, Inc. All rights reserved.</span>
        <span>&bull;</span>
        <span class="tracking-wider">Powered by Shopify</span>
      </div>

    </div>
  </div>
</footer>

<script is:inline>
  // Mobile Footer Accordion
  document.querySelectorAll('.footer-accordion-group button').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling;
      const chevron = button.querySelector('.accordion-chevron');
      if (content) {
        const isHidden = content.classList.contains('hidden');
        content.classList.toggle('hidden', !isHidden);
        if (chevron) chevron.textContent = isHidden ? '−' : '+';
      }
    });
  });

  // Newsletter Form Submit
  const nordicForm = document.getElementById('nordic-newsletter-form');
  if (nordicForm) {
    nordicForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = document.getElementById('nordic-newsletter-success');
      if (msg) msg.classList.remove('hidden');
      nordicForm.reset();
    });
  }
</script>
