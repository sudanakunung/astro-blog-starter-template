---
interface Props {
  storyMedia?: string;
}

const { storyMedia } = Astro.props;

function isVideoUrl(url?: string): boolean {
  if (!url) return true;
  const clean = url.split('?')[0].toLowerCase();
  return clean.endsWith('.mp4') || clean.endsWith('.webm') || clean.endsWith('.mov') || clean.endsWith('.ogg') || clean.endsWith('.mkv');
}

const mediaSrc = storyMedia || 'https://assets.mixkit.co/videos/preview/mixkit-indoor-pool-with-warm-lighting-in-a-spa-41883-large.mp4';
const isVideo = isVideoUrl(mediaSrc);
---

<section id="story" class="relative w-full h-[75vh] min-h-[520px] max-h-[820px] overflow-hidden bg-[#2D2A26] flex items-center justify-end">
  <!-- Full-Width Spa Ambient Background Video or Photo -->
  {isVideo ? (
    <video
      autoplay
      muted
      loop
      playsinline
      poster="https://images.unsplash.com/photo-1540555700478-4be289fbecef?q=80&w=1920&auto=format&fit=crop"
      class="absolute inset-0 w-full h-full object-cover object-center"
      style="filter: brightness(0.85);"
    >
      <source src={mediaSrc} type="video/mp4" />
    </video>
  ) : (
    <img
      src={mediaSrc}
      alt="Our Story"
      class="absolute inset-0 w-full h-full object-cover object-center"
      style="filter: brightness(0.85);"
    />
  )}

  <!-- Editorial Warm Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-l from-black/75 via-black/40 to-transparent pointer-events-none"></div>

  <!-- Text Overlay on the Right -->
  <div class="relative z-10 max-w-[1540px] mx-auto w-full px-6 sm:px-12 lg:px-20 flex justify-end">
    <div class="max-w-xl text-left md:text-right text-white">
      
      <span class="inline-block text-[11px] sm:text-xs tracking-[0.25em] uppercase font-light text-neutral-300 mb-3">
        Spa Heritage &bull; Founded in 2003
      </span>

      <h2 class="font-serif text-2xl sm:text-4xl lg:text-5xl font-light tracking-tight leading-[1.25] text-white">
        Our story began in the spa &mdash; where effective skincare must deliver both visible results and a deeply sensorial experience.
      </h2>

      <p class="mt-4 sm:mt-6 text-xs sm:text-sm font-light text-neutral-200 leading-relaxed max-w-lg md:ml-auto">
        Inspired by the lush botanical wealth of the Austrian Alps, every formula blends alpine wild harvesting with clean biotechnology.
      </p>

      <div class="mt-8">
        <a
          href="#ritual"
          class="inline-block border border-white text-white hover:bg-white hover:text-black px-8 sm:px-10 py-3 text-[11px] sm:text-xs tracking-[0.25em] uppercase font-medium transition-all duration-300"
        >
          Learn More
        </a>
      </div>

    </div>
  </div>
</section>
