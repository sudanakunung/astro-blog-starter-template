---
interface Props {
  brandName?: string;
}

const { brandName = 'SUSANNE KAUFMANN' } = Astro.props;

const menuLinks = [
  { label: 'Face', href: '#ritual' },
  { label: 'Body', href: '#ritual' },
  { label: 'Sets', href: '#collections' },
  { label: 'Routines', href: '#scent' },
  { label: 'Spa', href: '#story' },
  { label: 'About', href: '#story' },
];
---

<header class="sticky top-0 z-40 bg-white border-b border-[#E8E4DC] transition-all duration-300">
  <div class="max-w-[1540px] mx-auto px-4 sm:px-8 lg:px-12 h-18 sm:h-22 flex items-center justify-between">
    
    <!-- Left: Brand Logo in Elegant Serif -->
    <div class="flex-1 flex items-center justify-start">
      <!-- Mobile Menu Toggle Button -->
      <button
        id="kaufmann-mobile-menu-btn"
        class="lg:hidden p-2 -ml-2 mr-3 text-neutral-900 hover:opacity-70 focus:outline-none"
        aria-label="Toggle Navigation"
      >
        <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <a href="/" class="tracking-wide no-underline hover:no-underline inline-block group">
        <span class="font-serif text-lg sm:text-xl md:text-2xl tracking-[0.22em] font-light uppercase text-[#111111] group-hover:opacity-80 transition-opacity">
          {brandName}
        </span>
      </a>
    </div>

    <!-- Center: Main Navigation Menu -->
    <nav class="hidden lg:flex items-center space-x-7 xl:space-x-10 text-[12px] tracking-[0.22em] uppercase font-light text-neutral-800">
      {menuLinks.map((link) => (
        <a
          href={link.href}
          class="relative py-1 hover:text-black transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-black hover:after:w-full after:transition-all after:duration-300"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right: Search, Wishlist, Account, Cart -->
    <div class="flex-1 flex items-center justify-end space-x-3 sm:space-x-5 text-neutral-900">
      <!-- Search Trigger -->
      <a
        href="#ritual"
        class="p-2 text-neutral-900 hover:text-black transition-opacity hover:opacity-70 focus:outline-none"
        aria-label="Search"
        title="Search"
      >
        <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>

      <!-- Wishlist Trigger -->
      <button
        id="kaufmann-wishlist-btn"
        type="button"
        class="p-2 relative inline-flex items-center text-neutral-900 hover:opacity-70 transition-opacity focus:outline-none"
        aria-label="Wishlist"
        title="Wishlist"
      >
        <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
        <span
          class="wishlist-badge-counter wishlist-nav-badge absolute top-1 right-0 bg-[#111111] text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>

      <!-- Account Link -->
      <a
        id="kaufmann-account-btn"
        href="/account/login"
        class="p-2 relative inline-flex items-center text-neutral-900 hover:opacity-70 transition-opacity focus:outline-none"
        aria-label="Account"
        title="Account"
      >
        <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
      </a>

      <!-- Cart Trigger -->
      <button
        id="kaufmann-cart-btn"
        type="button"
        class="p-2 relative inline-flex items-center text-neutral-900 hover:opacity-70 transition-opacity focus:outline-none group"
        aria-label="Cart"
        title="Shopping Bag"
      >
        <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span
          class="cart-badge-counter cart-nav-badge absolute top-1 right-0 bg-[#111111] text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="kaufmann-mobile-menu" class="hidden lg:hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm transition-opacity">
    <div class="fixed inset-y-0 left-0 max-w-sm w-full bg-[#FAF8F5] shadow-2xl p-6 sm:p-8 flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-[#E8E4DC]">
          <span class="font-serif text-lg tracking-[0.2em] uppercase font-light text-[#111111]">{brandName}</span>
          <button id="kaufmann-close-mobile-menu" class="p-2 text-neutral-600 hover:text-black" aria-label="Close">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <nav class="py-8 flex flex-col space-y-5 text-[13px] tracking-[0.22em] uppercase font-light text-neutral-900">
          {menuLinks.map((link) => (
            <a href={link.href} class="hover:text-neutral-500 py-1.5 border-b border-[#E8E4DC]/60 flex items-center justify-between">
              <span>{link.label}</span>
              <span class="text-neutral-400 font-sans">&rarr;</span>
            </a>
          ))}
          <a id="kaufmann-mobile-account-link" href="/account/login" class="hover:text-neutral-500 py-1.5 border-b border-[#E8E4DC]/60 flex items-center justify-between">
            <span>My Account / Login</span>
            <span class="text-neutral-400 font-sans">&rarr;</span>
          </a>
        </nav>
      </div>

      <div class="pt-6 border-t border-[#E8E4DC] text-xs text-neutral-500 font-light space-y-1">
        <p class="font-medium text-neutral-800">Holistic Skincare &amp; Body Rituals</p>
        <p>Made in Austria &amp; Switzerland</p>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const mobileBtn = document.getElementById('kaufmann-mobile-menu-btn');
    const closeBtn = document.getElementById('kaufmann-close-mobile-menu');
    const mobileMenu = document.getElementById('kaufmann-mobile-menu');
    const cartBtn = document.getElementById('kaufmann-cart-btn');
    const wishlistBtn = document.getElementById('kaufmann-wishlist-btn');
    const accountBtn = document.getElementById('kaufmann-account-btn');
    const mobileAccountLink = document.getElementById('kaufmann-mobile-account-link');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => mobileMenu.classList.remove('hidden'));
    }
    if (closeBtn && mobileMenu) {
      closeBtn.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    }

    // Connect to global cart drawer
    if (cartBtn) {
      cartBtn.addEventListener('click', () => {
        window.NordicCart?.open();
      });
    }

    // Connect to global wishlist drawer
    if (wishlistBtn) {
      wishlistBtn.addEventListener('click', () => {
        window.NordicWishlist?.open();
      });
    }

    // Auth status reflection
    const token = localStorage.getItem('nordic_auth_token');
    const customer = (() => {
      try {
        return JSON.parse(localStorage.getItem('nordic_customer') || 'null');
      } catch {
        return null;
      }
    })();

    if (token && customer) {
      if (accountBtn) {
        accountBtn.title = `Welcome, ${customer.name}`;
        accountBtn.setAttribute('href', '/account/profile');
        const svg = accountBtn.querySelector('svg');
        if (svg) {
          svg.setAttribute('fill', 'currentColor');
          svg.setAttribute('stroke', 'none');
          svg.innerHTML = '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>';
        }
      }
      if (mobileAccountLink) {
        mobileAccountLink.setAttribute('href', '/account/profile');
        mobileAccountLink.textContent = `My Account (${customer.name})`;
      }
    }
  })();
</script>
