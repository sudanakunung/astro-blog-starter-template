---
// Section 12: FOOTER
interface Props {
  brandName?: string;
}

const { brandName = 'SUSANNE KAUFMANN' } = Astro.props;

const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: 'About Us',
    links: [
      { label: 'Philosophy & Spa Roots', href: '#story' },
      { label: 'Our Alpine Botanicals', href: '#ritual' },
      { label: 'Sustainability & Refills', href: '#story' },
      { label: 'Spa Locations & Resorts', href: '#story' },
    ],
  },
  {
    title: 'Information',
    links: [
      { label: 'Shipping & Delivery', href: '#about' },
      { label: 'Returns & Exchanges', href: '#about' },
      { label: 'Track Your Order', href: '/account/login' },
      { label: 'Terms & Conditions', href: '#' },
    ],
  },
  {
    title: 'Help',
    links: [
      { label: 'Customer Care', href: '#about' },
      { label: 'Frequently Asked Questions', href: '#about' },
      { label: 'Contact Us', href: '#about' },
      { label: 'Store & Stockist Locator', href: '#about' },
    ],
  },
  {
    title: 'Useful Links',
    links: [
      { label: 'Ritual Finder Quiz', href: '#ritual' },
      { label: 'Gift Cards', href: '#collections' },
      { label: 'Loyalty Program', href: '/account/register' },
      { label: 'Press & Editorial', href: '#story' },
    ],
  },
];
---

<footer class="kaufmann-footer w-full" style="background-color: #111111 !important; color: #ffffff !important; border-top: 1px solid #262626;">
  <div class="max-w-[1540px] mx-auto px-4 sm:px-8 lg:px-12 pt-16 sm:pt-20 pb-12">
    
    <!-- Top Row: 4 Columns Links + Language/Currency Selector -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12 pb-16" style="border-bottom: 1px solid #262626;">
      
      <!-- 4 Link Columns -->
      {footerColumns.map((col) => (
        <div class="footer-col">
          <h4 class="footer-col-title">
            {col.title}
          </h4>
          <ul class="footer-col-list">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- 5th Column: Region / Currency Selector -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1 pt-6 lg:pt-0" style="border-top: 1px solid #262626; lg:border-top: none;">
        <h4 class="footer-col-title">
          Location &amp; Currency
        </h4>

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <!-- Country Selector -->
          <div style="position: relative;">
            <select class="footer-select">
              <option value="id" selected>Indonesia (IDR Rp)</option>
              <option value="at">Austria (EUR €)</option>
              <option value="ch">Switzerland (CHF)</option>
              <option value="de">Germany (EUR €)</option>
              <option value="us">United States (USD $)</option>
              <option value="uk">United Kingdom (GBP £)</option>
            </select>
            <div style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #9ca3af;">
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>

          <p class="footer-note">
            Prices and shipping duties calculated at checkout.
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Row: Social Icons, Payment Methods & Copyright -->
    <div class="footer-bottom-row pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Left: Social Icons -->
      <div class="flex items-center space-x-5 footer-social-icons">
        <a href="https://instagram.com" target="_blank" rel="noopener" class="footer-social-link" title="Instagram">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener" class="footer-social-link" title="Facebook">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
        </a>
        <a href="https://pinterest.com" target="_blank" rel="noopener" class="footer-social-link" title="Pinterest">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.334 1.357-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 12-5.373 12-12 0-6.628-5.393-12-12-12z"/></svg>
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener" class="footer-social-link" title="YouTube">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>

      <!-- Center: Payment Method Badges -->
      <div class="flex items-center space-x-2 footer-payment-badges">
        <span class="payment-badge">VISA</span>
        <span class="payment-badge">MC</span>
        <span class="payment-badge">AMEX</span>
        <span class="payment-badge">PAYPAL</span>
        <span class="payment-badge">APPLE PAY</span>
      </div>

      <!-- Right: Copyright Text -->
      <div class="footer-copyright">
        &copy; {currentYear} {brandName}. All rights reserved. Holistic Beauty &amp; Alpine Botanicals.
      </div>

    </div>

  </div>
</footer>

<style>
  .kaufmann-footer {
    background-color: #111111 !important;
    color: #ffffff !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }

  .footer-col-title {
    font-size: 11px !important;
    letter-spacing: 0.25em !important;
    text-transform: uppercase !important;
    font-weight: 600 !important;
    color: #f3f4f6 !important;
    margin-bottom: 1.25rem !important;
    display: block !important;
  }

  .footer-col-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.65rem !important;
  }

  .footer-link {
    font-size: 12px !important;
    color: #9ca3af !important;
    text-decoration: none !important;
    font-weight: 300 !important;
    letter-spacing: 0.05em !important;
    transition: color 0.2s ease !important;
  }

  .footer-link:hover {
    color: #ffffff !important;
  }

  .footer-select {
    width: 100% !important;
    background-color: #1f1f1f !important;
    border: 1px solid #374151 !important;
    color: #ffffff !important;
    font-size: 12px !important;
    padding: 8px 14px !important;
    border-radius: 2px !important;
    letter-spacing: 0.05em !important;
    outline: none !important;
    appearance: none !important;
    cursor: pointer !important;
  }

  .footer-select:focus {
    border-color: #9ca3af !important;
  }

  .footer-select option {
    background-color: #1f1f1f !important;
    color: #ffffff !important;
  }

  .footer-note {
    font-size: 10px !important;
    color: #9ca3af !important;
    font-weight: 300 !important;
    line-height: 1.5 !important;
  }

  .footer-social-icons {
    display: flex !important;
    align-items: center !important;
    gap: 1.25rem !important;
  }

  .footer-social-link {
    color: #9ca3af !important;
    transition: color 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .footer-social-link:hover {
    color: #ffffff !important;
  }

  .footer-payment-badges {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
  }

  .payment-badge {
    padding: 3px 7px !important;
    background-color: #1f1f1f !important;
    border: 1px solid #374151 !important;
    border-radius: 2px !important;
    font-size: 9px !important;
    font-family: ui-monospace, monospace !important;
    color: #9ca3af !important;
    letter-spacing: 0.05em !important;
  }

  .footer-copyright {
    font-size: 11px !important;
    color: #9ca3af !important;
    font-weight: 300 !important;
    letter-spacing: 0.05em !important;
  }
</style>
