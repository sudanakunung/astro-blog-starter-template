---
import type { CarouselSlide } from '../types/store';

interface Props {
  slides: CarouselSlide[];
}

const { slides = [] } = Astro.props;
const safeSlides = slides.length > 0 ? slides : [];
---

{safeSlides.length > 0 && (
  <div class="carousel relative container mx-auto" style="max-width:1600px;" id="hero-carousel" data-slides-count={safeSlides.length}>
    <div class="carousel-inner relative overflow-hidden w-full" style="min-height: 480px; height: 50vh;">
      {safeSlides.map((slide, idx) => (
        <div
          class={`carousel-slide-item absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out ${
            idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
          }`}
          data-index={idx}
        >
          <div
            class="block h-full w-full mx-auto flex pt-6 md:pt-0 md:items-center bg-cover bg-center"
            style={`background-image: url('${slide.image}'); background-color: #f1f5f9;`}
          >
            <div class="container mx-auto">
              <div class="flex flex-col w-full lg:w-1/2 md:ml-16 items-center md:items-start px-6 tracking-wide bg-white/70 md:bg-white/80 backdrop-blur-sm p-6 md:p-8 rounded-2xl shadow-sm border border-white/50">
                <p class="text-slate-900 text-2xl md:text-3xl my-2 md:my-4 font-normal leading-snug">
                  {slide.title}
                </p>
                <a
                  class="text-lg md:text-xl inline-flex items-center gap-2 font-medium text-slate-800 border-b-2 border-slate-800 pb-0.5 hover:text-indigo-600 hover:border-indigo-600 transition-colors"
                  href={slide.link}
                >
                  <span>{slide.linkText || 'view product'}</span>
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}

      {safeSlides.length > 1 && (
        <>
          <!-- Prev / Next Navigation Buttons -->
          <button
            id="carousel-btn-prev"
            type="button"
            aria-label="Previous slide"
            class="w-10 h-10 ml-2 md:ml-8 absolute cursor-pointer text-2xl font-bold text-slate-800 hover:text-white rounded-full bg-white/80 hover:bg-slate-900 shadow-md backdrop-blur-sm leading-tight flex items-center justify-center z-20 inset-y-0 left-0 my-auto transition-all"
          >
            &#8249;
          </button>
          <button
            id="carousel-btn-next"
            type="button"
            aria-label="Next slide"
            class="w-10 h-10 mr-2 md:mr-8 absolute cursor-pointer text-2xl font-bold text-slate-800 hover:text-white rounded-full bg-white/80 hover:bg-slate-900 shadow-md backdrop-blur-sm leading-tight flex items-center justify-center z-20 inset-y-0 right-0 my-auto transition-all"
          >
            &#8250;
          </button>

          <!-- Indicators -->
          <ol class="carousel-indicators absolute bottom-4 left-0 right-0 flex justify-center items-center gap-2 z-20">
            {safeSlides.map((_, idx) => (
              <li>
                <button
                  type="button"
                  data-target-index={idx}
                  class={`carousel-indicator-dot h-2.5 rounded-full transition-all duration-300 ${
                    idx === 0 ? 'w-8 bg-slate-900' : 'w-2.5 bg-slate-400 hover:bg-slate-600'
                  }`}
                  aria-label={`Go to slide ${idx + 1}`}
                />
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </div>
)}

<script is:inline>
  (function initHeroCarousel() {
    const root = document.getElementById('hero-carousel');
    if (!root) return;

    const slides = root.querySelectorAll('.carousel-slide-item');
    const dots = root.querySelectorAll('.carousel-indicator-dot');
    const btnPrev = document.getElementById('carousel-btn-prev');
    const btnNext = document.getElementById('carousel-btn-next');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let autoPlayTimer = null;

    function goToSlide(index) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove('w-2.5', 'bg-slate-400');
          dot.classList.add('w-8', 'bg-slate-900');
        } else {
          dot.classList.remove('w-8', 'bg-slate-900');
          dot.classList.add('w-2.5', 'bg-slate-400');
        }
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        prevSlide();
        startAutoPlay();
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        nextSlide();
        startAutoPlay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-target-index') || '0', 10);
        goToSlide(target);
        startAutoPlay();
      });
    });

    root.addEventListener('mouseenter', stopAutoPlay);
    root.addEventListener('mouseleave', startAutoPlay);

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    root.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    root.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        nextSlide();
      } else if (touchEndX - touchStartX > 40) {
        prevSlide();
      }
      startAutoPlay();
    }, { passive: true });

    startAutoPlay();
  })();
</script>
