---
import type { CarouselSlide } from '../types/store';

interface Props {
  slides: CarouselSlide[];
}

const { slides = [] } = Astro.props;
const safeSlides = slides.length > 0 ? slides : [];
---

{safeSlides.length > 0 && (
  <div class="carousel relative container mx-auto px-2 sm:px-4 md:px-6" id="hero-carousel" data-slides-count={safeSlides.length}>
    <div class="carousel-inner hero-carousel-box relative overflow-hidden w-full rounded-xl sm:rounded-2xl">
      {safeSlides.map((slide, idx) => (
        <div
          class={`carousel-slide-item absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out ${
            idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
          }`}
          data-index={idx}
        >
          <div
            class="hero-slide-bg block h-full w-full mx-auto"
            style={`background-image: url('${slide.image}'); background-color: #f1f5f9;`}
          >
            <div class="container mx-auto px-3 sm:px-6 h-full flex items-end pb-5 sm:pb-8 md:pb-12">
              <div class="flex flex-col items-start md:ml-6 lg:ml-10 max-w-lg">
                {slide.title && (
                  <span class="inline-block bg-white/95 backdrop-blur-md text-neutral-900 text-[11px] sm:text-xs md:text-sm font-semibold px-3 py-1 sm:px-4 sm:py-1.5 rounded-full mb-2 sm:mb-3 shadow-md border border-white/60 tracking-wider uppercase">
                    {slide.title}
                  </span>
                )}
                <a
                  class="inline-flex items-center gap-1.5 sm:gap-2.5 bg-black hover:bg-neutral-800 active:bg-neutral-900 text-white font-semibold text-[11px] sm:text-xs md:text-sm tracking-wider uppercase px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-full shadow-2xl transition-all duration-200 transform hover:-translate-y-0.5 border border-white/20"
                  href={slide.link || '#'}
                >
                  <span>{slide.linkText || 'Lihat Produk'}</span>
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}

      {safeSlides.length > 1 && (
        <>
          <!-- Prev / Next Navigation Buttons -->
          <button
            id="carousel-btn-prev"
            type="button"
            aria-label="Previous slide"
            class="w-8 h-8 sm:w-10 sm:h-10 ml-1.5 sm:ml-4 md:ml-6 absolute cursor-pointer text-base sm:text-xl font-bold text-white hover:text-white rounded-full bg-black/60 hover:bg-black shadow-lg backdrop-blur-md leading-tight flex items-center justify-center z-20 inset-y-0 left-0 my-auto transition-all"
          >
            &#8249;
          </button>
          <button
            id="carousel-btn-next"
            type="button"
            aria-label="Next slide"
            class="w-8 h-8 sm:w-10 sm:h-10 mr-1.5 sm:ml-4 md:mr-6 absolute cursor-pointer text-base sm:text-xl font-bold text-white hover:text-white rounded-full bg-black/60 hover:bg-black shadow-lg backdrop-blur-md leading-tight flex items-center justify-center z-20 inset-y-0 right-0 my-auto transition-all"
          >
            &#8250;
          </button>

          <!-- Indicators -->
          <ol class="carousel-indicators absolute bottom-2 sm:bottom-4 left-0 right-0 flex justify-center items-center gap-1.5 sm:gap-2 z-20">
            {safeSlides.map((_, idx) => (
              <li>
                <button
                  type="button"
                  data-target-index={idx}
                  class={`carousel-indicator-dot h-1.5 sm:h-2 rounded-full transition-all duration-300 ${
                    idx === 0 ? 'w-5 sm:w-7 bg-black' : 'w-1.5 sm:w-2 bg-black/30 hover:bg-black/60'
                  }`}
                  aria-label={`Go to slide ${idx + 1}`}
                />
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </div>
)}

<style>
  /* Responsif Tinggi Banner agar proporsi landscape tidak terpotong di mobile */
  .hero-carousel-box {
    height: 56vw;
    min-height: 210px;
    max-height: 340px;
  }

  @media (min-width: 640px) {
    .hero-carousel-box {
      height: 48vw;
      min-height: 380px;
      max-height: 480px;
    }
  }

  @media (min-width: 1024px) {
    .hero-carousel-box {
      height: 50vh;
      min-height: 460px;
      max-height: 580px;
    }
  }

  .hero-slide-bg {
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
  }
</style>

<script is:inline>
  (function initHeroCarousel() {
    const root = document.getElementById('hero-carousel');
    if (!root) return;

    const slides = root.querySelectorAll('.carousel-slide-item');
    const dots = root.querySelectorAll('.carousel-indicator-dot');
    const btnPrev = document.getElementById('carousel-btn-prev');
    const btnNext = document.getElementById('carousel-btn-next');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let autoPlayTimer = null;

    function goToSlide(index) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove('w-1.5', 'sm:w-2', 'bg-black/30');
          dot.classList.add('w-5', 'sm:w-7', 'bg-black');
        } else {
          dot.classList.remove('w-5', 'sm:w-7', 'bg-black');
          dot.classList.add('w-1.5', 'sm:w-2', 'bg-black/30');
        }
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        prevSlide();
        startAutoPlay();
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        nextSlide();
        startAutoPlay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-target-index') || '0', 10);
        goToSlide(target);
        startAutoPlay();
      });
    });

    root.addEventListener('mouseenter', stopAutoPlay);
    root.addEventListener('mouseleave', startAutoPlay);

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    root.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    root.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        nextSlide();
      } else if (touchEndX - touchStartX > 40) {
        prevSlide();
      }
      startAutoPlay();
    }, { passive: true });

    startAutoPlay();
  })();
</script>
