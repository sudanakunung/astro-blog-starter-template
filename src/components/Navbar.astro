---
import { navLinks } from "../data/storeData";

interface Props {
  storeName?: string;
}

const { storeName = "NORDICS" } = Astro.props;
---

<!--Nav-->
<nav
  id="header"
  class="w-full z-30 top-0 py-1 bg-white sticky shadow-xs border-b border-gray-100"
>
  <div
    class="w-full container mx-auto flex flex-wrap items-center justify-between mt-0 px-4 sm:px-6 py-3"
  >
    <!-- Hamburger Toggle for Mobile -->
    <label
      for="menu-toggle"
      class="cursor-pointer md:hidden flex items-center p-1.5 -ml-1 text-gray-800 hover:text-black focus:outline-none"
      aria-label="Toggle navigation"
    >
      <svg
        class="fill-current text-gray-900"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 20 20"
      >
        <title>menu</title>
        <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
      </svg>
    </label>
    <input class="hidden" type="checkbox" id="menu-toggle" />

    <!-- Navigation Menu Links & Mobile Action Drawer -->
    <div
      class="hidden md:flex md:items-center md:w-auto w-full order-3 md:order-1"
      id="menu"
    >
      <nav class="w-full">
        <ul
          class="md:flex items-center justify-between text-base text-gray-700 pt-4 md:pt-0 border-t border-gray-100 md:border-t-0 mt-3 md:mt-0"
        >
          {
            navLinks.map((item) => (
              <li>
                <a
                  class="block md:inline-block no-underline hover:text-black hover:bg-gray-50 md:hover:bg-transparent rounded-lg py-2.5 px-3 md:px-4 font-medium text-sm md:text-base transition-colors"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Mobile User, Wishlist & Cart Icons inside Burger Menu -->
        <div class="md:hidden pt-4 mt-3 border-t border-gray-100 pb-2">
          <div class="text-[11px] font-semibold tracking-wider text-gray-400 uppercase px-1 mb-2.5">
            Aktivitas Saya
          </div>
          <div class="grid grid-cols-3 gap-2.5">
            <!-- Mobile Account Button -->
            <a
              id="mobile-nav-account-btn"
              href="/account/login"
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-800 transition-colors"
              aria-label="Akun Saya"
            >
              <div class="relative w-6 h-6 flex items-center justify-center">
                <svg
                  class="w-5 h-5 fill-none stroke-current"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path>
                </svg>
              </div>
              <span id="mobile-account-label" class="text-xs mt-1.5 font-medium">Akun</span>
            </a>

            <!-- Mobile Wishlist Button -->
            <button
              id="mobile-nav-wishlist-btn"
              type="button"
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-800 transition-colors relative focus:outline-none"
              aria-label="Buka Wishlist"
            >
              <div class="relative w-6 h-6 flex items-center justify-center">
                <svg
                  class="w-5 h-5 fill-none stroke-current"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path>
                </svg>
                <span
                  class="wishlist-badge-counter wishlist-nav-badge absolute -top-1.5 -right-2 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
                >
                  0
                </span>
              </div>
              <span class="text-xs mt-1.5 font-medium">Wishlist</span>
            </button>

            <!-- Mobile Cart Button -->
            <button
              id="mobile-nav-cart-btn"
              type="button"
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-800 transition-colors relative focus:outline-none"
              aria-label="Buka Keranjang Belanja"
            >
              <div class="relative w-6 h-6 flex items-center justify-center">
                <svg
                  class="w-5 h-5 fill-none stroke-current"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                  ></path>
                </svg>
                <span
                  class="cart-badge-counter cart-nav-badge absolute -top-1.5 -right-2 bg-black text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
                >
                  0
                </span>
              </div>
              <span class="text-xs mt-1.5 font-medium">Keranjang</span>
            </button>
          </div>
        </div>
      </nav>
    </div>

    <!-- Brand Logo / Store Name -->
    <div class="order-1 md:order-2">
      <a
        class="flex items-center tracking-wide no-underline hover:no-underline font-bold text-gray-800 text-lg sm:text-xl uppercase"
        href="/"
      >
        <svg
          class="fill-current text-gray-800 mr-2 flex-shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
        >
          <path
            d="M5,22h14c1.103,0,2-0.897,2-2V9c0-0.553-0.447-1-1-1h-3V7c0-2.757-2.243-5-5-5S7,4.243,7,7v1H4C3.447,8,3,8.447,3,9v11 C3,21.103,3.897,22,5,22z M9,7c0-1.654,1.346-3,3-3s3,1.346,3,3v1H9V7z M5,10h2v2h2v-2h6v2h2v-2h2l0.002,10H5V10z"
          ></path>
        </svg>
        <span id="navbar-brand-name">{storeName}</span>
      </a>
    </div>

    <!-- Action Icons: Account, Wishlist & Cart (Desktop Only) -->
    <div
      class="hidden md:flex items-center space-x-2 md:order-3"
      id="nav-content"
    >
      <!-- Account Button -->
      <a
        id="nav-account-btn"
        href="/account/login"
        class="p-2 relative inline-block text-gray-700 hover:text-black transition-colors focus:outline-none"
        aria-label="Akun Saya"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
      </a>

      <!-- Wishlist Button Trigger -->
      <button
        id="nav-wishlist-btn"
        type="button"
        class="p-2 relative inline-block text-gray-700 hover:text-black transition-colors focus:outline-none"
        aria-label="Buka Wishlist"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
        <span
          class="wishlist-badge-counter wishlist-nav-badge absolute top-1 right-0 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>

      <!-- Cart Button Trigger -->
      <button
        id="nav-cart-btn"
        type="button"
        class="p-2 relative inline-block text-gray-700 hover:text-black transition-colors focus:outline-none"
        aria-label="Buka Keranjang Belanja"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span
          class="cart-badge-counter cart-nav-badge absolute top-1 right-0 bg-black text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>
    </div>
  </div>
</nav>

<style>
  #menu-toggle:checked + #menu {
    display: block;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const cartBtn = document.getElementById("nav-cart-btn");
    const wishlistBtn = document.getElementById("nav-wishlist-btn");
    const accountBtn = document.getElementById("nav-account-btn");

    const mobileCartBtn = document.getElementById("mobile-nav-cart-btn");
    const mobileWishlistBtn = document.getElementById("mobile-nav-wishlist-btn");
    const mobileAccountBtn = document.getElementById("mobile-nav-account-btn");
    const mobileAccountLabel = document.getElementById("mobile-account-label");

    // Cart actions
    if (cartBtn) {
      cartBtn.addEventListener("click", () => {
        window.NordicCart?.open();
      });
    }
    if (mobileCartBtn) {
      mobileCartBtn.addEventListener("click", () => {
        if (menuToggle) menuToggle.checked = false;
        window.NordicCart?.open();
      });
    }

    // Wishlist actions
    if (wishlistBtn) {
      wishlistBtn.addEventListener("click", () => {
        window.NordicWishlist?.open();
      });
    }
    if (mobileWishlistBtn) {
      mobileWishlistBtn.addEventListener("click", () => {
        if (menuToggle) menuToggle.checked = false;
        window.NordicWishlist?.open();
      });
    }

    // Update account button based on login status
    const token = localStorage.getItem("nordic_auth_token");
    const customer = (() => {
      try {
        return JSON.parse(localStorage.getItem("nordic_customer") || "null");
      } catch {
        return null;
      }
    })();

    if (token && customer) {
      const applyLoggedIn = (btn, labelEl) => {
        if (!btn) return;
        btn.title = `Hai, ${customer.name}`;
        btn.setAttribute('href', '/account/profile');
        const svg = btn.querySelector("svg");
        if (svg) {
          svg.setAttribute("fill", "currentColor");
          svg.setAttribute("stroke", "none");
          svg.innerHTML =
            '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>';
        }
        if (labelEl) {
          labelEl.textContent = customer.name ? customer.name.split(' ')[0] : 'Profil';
        }
      };

      applyLoggedIn(accountBtn);
      applyLoggedIn(mobileAccountBtn, mobileAccountLabel);
    }
  });
</script>
