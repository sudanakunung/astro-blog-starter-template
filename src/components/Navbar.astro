---
import { navLinks } from "../data/storeData";

interface Props {
  storeName?: string;
}

const { storeName = "NORDICS" } = Astro.props;
---

<!--Nav-->
<nav
  id="header"
  class="w-full z-30 top-0 py-1 bg-white sticky shadow-xs border-b border-gray-100"
>
  <div
    class="w-full container mx-auto flex flex-wrap items-center justify-between mt-0 px-6 py-3"
  >
    <!-- Hamburger Toggle for Mobile -->
    <label
      for="menu-toggle"
      class="cursor-pointer md:hidden block"
      aria-label="Toggle navigation"
    >
      <svg
        class="fill-current text-gray-900"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 20 20"
      >
        <title>menu</title>
        <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
      </svg>
    </label>
    <input class="hidden" type="checkbox" id="menu-toggle" />

    <!-- Navigation Menu Links -->
    <div
      class="hidden md:flex md:items-center md:w-auto w-full order-3 md:order-1"
      id="menu"
    >
      <nav>
        <ul
          class="md:flex items-center justify-between text-base text-gray-700 pt-4 md:pt-0"
        >
          {
            navLinks.map((item) => (
              <li>
                <a
                  class="inline-block no-underline hover:text-black hover:underline py-2 px-4"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Brand Logo / Store Name -->
    <div class="order-1 md:order-2">
      <a
        class="flex items-center tracking-wide no-underline hover:no-underline font-bold text-gray-800 text-xl uppercase"
        href="/"
      >
        <svg
          class="fill-current text-gray-800 mr-2"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path
            d="M5,22h14c1.103,0,2-0.897,2-2V9c0-0.553-0.447-1-1-1h-3V7c0-2.757-2.243-5-5-5S7,4.243,7,7v1H4C3.447,8,3,8.447,3,9v11 C3,21.103,3.897,22,5,22z M9,7c0-1.654,1.346-3,3-3s3,1.346,3,3v1H9V7z M5,10h2v2h2v-2h6v2h2v-2h2l0.002,10H5V10z"
          ></path>
        </svg>
        {storeName}
      </a>
    </div>

    <!-- Action Icons: Account, Wishlist & Cart -->
    <div
      class="order-2 md:order-3 flex items-center space-x-2"
      id="nav-content"
    >
      <!-- Account Button -->
      <a
        id="nav-account-btn"
        href="/account/login"
        class="p-2 relative inline-block text-gray-700 hover:text-black transition-colors focus:outline-none"
        aria-label="Akun Saya"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
      </a>

      <!-- Wishlist Button Trigger -->
      <button
        id="nav-wishlist-btn"
        type="button"
        class="p-2 relative inline-block text-gray-700 hover:text-black transition-colors focus:outline-none"
        aria-label="Buka Wishlist"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
        <span
          class="wishlist-badge-counter wishlist-nav-badge absolute top-1 right-0 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>

      <!-- Cart Button Trigger -->
      <button
        id="nav-cart-btn"
        type="button"
        class="p-2 relative inline-block text-gray-700 hover:text-black transition-colors focus:outline-none"
        aria-label="Buka Keranjang Belanja"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span
          class="cart-badge-counter cart-nav-badge absolute top-1 right-0 bg-black text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>
    </div>
  </div>
</nav>

<style>
  #menu-toggle:checked + #menu {
    display: block;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const cartBtn = document.getElementById("nav-cart-btn");
    const wishlistBtn = document.getElementById("nav-wishlist-btn");
    const accountBtn = document.getElementById("nav-account-btn");

    if (cartBtn) {
      cartBtn.addEventListener("click", () => {
        window.NordicCart?.open();
      });
    }

    if (wishlistBtn) {
      wishlistBtn.addEventListener("click", () => {
        window.NordicWishlist?.open();
      });
    }

    // Update account button based on login status
    const token = localStorage.getItem("nordic_auth_token");
    const customer = (() => {
      try {
        return JSON.parse(localStorage.getItem("nordic_customer") || "null");
      } catch {
        return null;
      }
    })();

    if (token && customer && accountBtn) {
      accountBtn.title = `Hai, ${customer.name}`;
      // Show filled person icon when logged in
      accountBtn.querySelector("svg").setAttribute("fill", "currentColor");
      accountBtn.querySelector("svg").setAttribute("stroke", "none");
      accountBtn.querySelector("svg").innerHTML =
        '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>';
    }
  });
</script>
