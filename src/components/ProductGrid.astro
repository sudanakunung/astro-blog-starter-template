---
import ProductCard from './ProductCard.astro';
import type { D1Product } from '../types/d1';

interface Props {
  products: D1Product[];
  title?: string;
}

const { products = [], title = 'Store' } = Astro.props;
---

<section id="store" class="bg-white py-10">
  <div class="container mx-auto px-4 sm:px-6">
    <!-- Store Header Bar -->
    <div class="flex items-center justify-between pb-6 mb-6 border-b border-gray-100">
      <h2 class="uppercase tracking-wider font-bold text-gray-900 text-xl md:text-2xl">
        {title}
      </h2>

      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-500 font-medium">{products.length} Produk</span>
      </div>
    </div>

    <!-- Product Grid Items with Uniform Columns & Heights -->
    {products.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 items-stretch">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <div class="w-full text-center py-16 text-gray-400 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
        <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        <p class="font-medium text-gray-600">Belum ada produk yang aktif di toko ini.</p>
        <p class="text-xs text-gray-400 mt-1">Tambahkan produk melalui menu Admin untuk mulai berjualan.</p>
      </div>
    )}
  </div>
</section>
