---
// TrustFeatures.astro - Section "TRUST US / We offer the best!"
---

<section class="bg-white py-14 md:py-20 border-t border-gray-100">
  <div class="container mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <p class="text-xs uppercase tracking-[0.25em] text-gray-400 font-medium mb-3">
        TRUST US
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-[2.75rem] text-gray-900 font-serif font-normal tracking-tight">
        We offer the best!
      </h2>
    </div>

    <!-- 4 Features Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-8 lg:gap-10 text-center">
      <!-- 1. 2-DAY SHIPPING -->
      <div class="flex flex-col items-center group">
        <div class="w-12 h-12 flex items-center justify-center mb-5 text-gray-900 transition-transform duration-300 group-hover:-translate-y-1">
          <svg
            class="w-10 h-10"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Isometric Box Top Surface -->
            <polygon points="24 6 40 15.5 24 25 8 15.5" />
            <!-- Box Body -->
            <polyline points="8 15.5 8 32.5 24 42 40 32.5 40 15.5" />
            <!-- Center Vertical Edge -->
            <line x1="24" y1="25" x2="24" y2="42" />
            <!-- Top Flap Seam -->
            <line x1="16" y1="10.75" x2="32" y2="20.25" />
            <!-- Center Packing Tape across seam -->
            <path d="M21 7.8 L21 23.2 L21 27" stroke-width="1.4" />
            <path d="M27 11.2 L27 26.8 L27 27" stroke-width="1.4" />
          </svg>
        </div>
        <h3 class="text-xs sm:text-[13px] font-bold tracking-[0.12em] text-gray-900 uppercase mb-2">
          2-DAY SHIPPING
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 leading-relaxed max-w-[230px]">
          Receive your items in record time, hassle-free.
        </p>
      </div>

      <!-- 2. FINANCING OPTIONS -->
      <div class="flex flex-col items-center group">
        <div class="w-12 h-12 flex items-center justify-center mb-5 text-gray-900 transition-transform duration-300 group-hover:-translate-y-1">
          <svg
            class="w-10 h-10"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Back Card -->
            <rect x="13" y="9" width="28" height="20" rx="3" />
            <line x1="13" y1="14" x2="41" y2="14" />
            <!-- Front Card -->
            <rect x="7" y="17" width="30" height="22" rx="3" fill="white" />
            <line x1="7" y1="23" x2="37" y2="23" stroke-width="2.5" />
            <!-- Front Card Chip / Details -->
            <line x1="12" y1="31" x2="18" y2="31" stroke-width="1.8" />
            <line x1="12" y1="34" x2="22" y2="34" stroke-width="1.5" />
          </svg>
        </div>
        <h3 class="text-xs sm:text-[13px] font-bold tracking-[0.12em] text-gray-900 uppercase mb-2">
          FINANCING OPTIONS
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 leading-relaxed max-w-[230px]">
          Find the perfect payment plan that suits your needs.
        </p>
      </div>

      <!-- 3. FREE SHIPPING -->
      <div class="flex flex-col items-center group">
        <div class="w-12 h-12 flex items-center justify-center mb-5 text-gray-900 transition-transform duration-300 group-hover:-translate-y-1">
          <svg
            class="w-10 h-10"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Truck Cargo Body -->
            <path d="M5 14H29V32H5V14Z" />
            <!-- Checkmark inside Cargo Box -->
            <path d="M12 23L16 27L23 19" stroke-width="2" />
            <!-- Truck Cabin -->
            <path d="M29 18H36L42 24V32H29V18Z" />
            <!-- Cabin Window -->
            <path d="M30 20H35L39 24H30V20Z" />
            <!-- Wheels -->
            <circle cx="14" cy="34" r="3.5" fill="white" />
            <circle cx="36" cy="34" r="3.5" fill="white" />
            <!-- Chassis / Bumper lines -->
            <line x1="5" y1="32" x2="10" y2="32" />
            <line x1="18" y1="32" x2="32" y2="32" />
            <line x1="40" y1="32" x2="43" y2="32" />
          </svg>
        </div>
        <h3 class="text-xs sm:text-[13px] font-bold tracking-[0.12em] text-gray-900 uppercase mb-2">
          FREE SHIPPING
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 leading-relaxed max-w-[230px]">
          Enjoy convenient shopping without additional costs.
        </p>
      </div>

      <!-- 4. REFUND POLICY -->
      <div class="flex flex-col items-center group">
        <div class="w-12 h-12 flex items-center justify-center mb-5 text-gray-900 transition-transform duration-300 group-hover:-translate-y-1">
          <svg
            class="w-10 h-10"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Top Counter-Clockwise Arrow -->
            <path d="M38 16 A 17 17 0 0 0 10 16" />
            <polyline points="15 16 10 16 10 11" />
            <!-- Bottom Counter-Clockwise Arrow -->
            <path d="M10 32 A 17 17 0 0 0 38 32" />
            <polyline points="33 32 38 32 38 37" />
            <!-- Center Mini Isometric Box -->
            <polygon points="24 16 32 20.5 24 25 16 20.5" fill="white" />
            <polyline points="16 20.5 16 29 24 33.5 32 29 32 20.5" />
            <line x1="24" y1="25" x2="24" y2="33.5" />
            <line x1="20" y1="18.25" x2="28" y2="22.75" stroke-width="1.2" />
          </svg>
        </div>
        <h3 class="text-xs sm:text-[13px] font-bold tracking-[0.12em] text-gray-900 uppercase mb-2">
          REFUND POLICY
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 leading-relaxed max-w-[230px]">
          Shop confidently knowing you can easily return any unwanted items.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap');
  
  .font-serif {
    font-family: 'Playfair Display', Georgia, Cambria, 'Times New Roman', Times, serif;
  }
</style>
