---
interface Props {
  brandName?: string;
}

const { brandName = 'IMPULSE' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-neutral-200 transition-all duration-300 shadow-xs" style="background-color: #ffffff !important;">
  <div class="max-w-[1500px] mx-auto px-4 sm:px-8 lg:px-12 h-16 sm:h-20 flex items-center justify-between">
    
    <!-- Left Column: Simple Clean Navigation (like Nordic) -->
    <div class="flex items-center space-x-6 flex-1 justify-start">
      <!-- Mobile Menu Toggle Button -->
      <button id="impulse-mobile-menu-btn" class="md:hidden p-2 -ml-2 text-neutral-800 hover:text-black focus:outline-none" aria-label="Toggle Navigation">
        <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <!-- Desktop Clean Navigation Links -->
      <nav class="hidden md:flex items-center space-x-7 lg:space-x-8 text-[12px] sm:text-[13px] tracking-[0.2em] uppercase font-medium text-neutral-800">
        <a href="#catalog" class="hover:text-black border-b border-transparent hover:border-black pb-0.5 transition-all">Shop</a>
        <a href="#about" class="hover:text-black border-b border-transparent hover:border-black pb-0.5 transition-all">About</a>
        <a href="#catalog" class="text-rose-700 hover:text-rose-900 border-b border-transparent hover:border-rose-900 pb-0.5 transition-all">Sale</a>
      </nav>
    </div>

    <!-- Center Column: Bold Editorial Logo (Spacious & Clean, No Collisions) -->
    <div class="flex-shrink-0 text-center px-4">
      <a href="/" class="inline-block tracking-wide no-underline hover:no-underline">
        <span class="font-serif text-xl sm:text-2xl lg:text-3xl tracking-[0.2em] font-light uppercase text-black hover:opacity-85 transition-opacity whitespace-nowrap">
          {brandName}
        </span>
      </a>
    </div>

    <!-- Right Column: Action Icons (Search, Account, Wishlist, Cart) -->
    <div class="flex items-center space-x-2 sm:space-x-3 flex-1 justify-end">
      <!-- Search Trigger Icon -->
      <a
        href="#catalog"
        id="impulse-search-btn"
        class="p-2 relative inline-flex items-center text-neutral-800 hover:text-black transition-colors focus:outline-none"
        aria-label="Cari Produk"
        title="Cari Produk"
      >
        <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>

      <!-- Account Button -->
      <a
        id="impulse-nav-account-btn"
        href="/account/login"
        class="p-2 relative inline-flex items-center text-neutral-800 hover:text-black transition-colors focus:outline-none"
        aria-label="Akun Saya"
        title="Akun Saya"
      >
        <svg
          class="w-5 h-5 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
      </a>

      <!-- Wishlist Trigger -->
      <button
        id="impulse-nav-wishlist-btn"
        type="button"
        class="p-2 relative inline-flex items-center text-neutral-800 hover:text-black transition-colors focus:outline-none"
        aria-label="Buka Wishlist"
        title="Wishlist"
      >
        <svg
          class="w-5 h-5 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
        <span
          class="wishlist-badge-counter wishlist-nav-badge absolute top-1 right-0 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>

      <!-- Cart Trigger (integrates with global CartDrawer) -->
      <button
        id="impulse-nav-cart-btn"
        type="button"
        class="p-2 relative inline-flex items-center text-neutral-800 hover:text-black transition-colors focus:outline-none group"
        aria-label="Buka Keranjang Belanja"
        title="Keranjang Belanja"
      >
        <svg
          class="w-5 h-5 fill-none stroke-current transition-transform group-hover:scale-105"
          viewBox="0 0 24 24"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
          ></path>
        </svg>
        <span
          class="cart-badge-counter cart-nav-badge absolute top-1 right-0 bg-black text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none hidden"
        >
          0
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu Overlay -->
  <div id="impulse-mobile-menu" class="hidden md:hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm transition-opacity">
    <div class="fixed inset-y-0 left-0 max-w-xs w-full bg-white shadow-2xl p-6 flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-neutral-100">
          <span class="font-serif text-xl tracking-[0.2em] uppercase font-bold">{brandName}</span>
          <button id="impulse-close-mobile-menu" class="p-2 text-neutral-500 hover:text-black" aria-label="Close Menu">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <nav class="py-6 flex flex-col space-y-4 text-[13px] tracking-[0.18em] uppercase font-medium text-neutral-900">
          <a href="#catalog" class="hover:text-neutral-500 py-2 border-b border-neutral-100 flex items-center justify-between">
            <span>Shop</span>
            <span class="text-neutral-400">&rarr;</span>
          </a>
          <a href="#about" class="hover:text-neutral-500 py-2 border-b border-neutral-100 flex items-center justify-between">
            <span>About</span>
            <span class="text-neutral-400">&rarr;</span>
          </a>
          <a href="#catalog" class="text-rose-700 hover:text-rose-900 py-2 border-b border-neutral-100 flex items-center justify-between">
            <span>Sale</span>
            <span class="text-[10px] bg-rose-100 text-rose-700 px-2 py-0.5 rounded-full font-bold">Promo</span>
          </a>
          <a id="impulse-mobile-account-link" href="/account/login" class="hover:text-neutral-500 py-2 border-b border-neutral-100 flex items-center justify-between">
            <span>Akun Saya</span>
            <span class="text-neutral-400">&rarr;</span>
          </a>
        </nav>
      </div>

      <div class="pt-6 border-t border-neutral-200 text-xs text-neutral-500 space-y-1">
        <p class="font-semibold text-neutral-700">{brandName}</p>
        <p>Minimalist Editorial Collection</p>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const mobileBtn = document.getElementById('impulse-mobile-menu-btn');
    const closeBtn = document.getElementById('impulse-close-mobile-menu');
    const mobileMenu = document.getElementById('impulse-mobile-menu');
    const cartBtn = document.getElementById('impulse-nav-cart-btn');
    const wishlistBtn = document.getElementById('impulse-nav-wishlist-btn');
    const accountBtn = document.getElementById('impulse-nav-account-btn');
    const mobileAccountLink = document.getElementById('impulse-mobile-account-link');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => mobileMenu.classList.remove('hidden'));
    }
    if (closeBtn && mobileMenu) {
      closeBtn.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    }

    // Connect to global cart and wishlist drawers
    if (cartBtn) {
      cartBtn.addEventListener('click', () => {
        window.NordicCart?.open();
      });
    }

    if (wishlistBtn) {
      wishlistBtn.addEventListener('click', () => {
        window.NordicWishlist?.open();
      });
    }

    // Update account button based on login status
    const token = localStorage.getItem('nordic_auth_token');
    const customer = (() => {
      try {
        return JSON.parse(localStorage.getItem('nordic_customer') || 'null');
      } catch {
        return null;
      }
    })();

    if (token && customer) {
      if (accountBtn) {
        accountBtn.title = `Hai, ${customer.name}`;
        accountBtn.setAttribute('href', '/account/profile');
        const svg = accountBtn.querySelector('svg');
        if (svg) {
          svg.setAttribute('fill', 'currentColor');
          svg.setAttribute('stroke', 'none');
          svg.innerHTML = '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>';
        }
      }
      if (mobileAccountLink) {
        mobileAccountLink.setAttribute('href', '/account/profile');
        mobileAccountLink.textContent = `Akun Saya (${customer.name})`;
      }
    }
  })();
</script>
