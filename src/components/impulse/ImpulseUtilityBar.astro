---
// Impulse Utility Bar Component - Clean White Minimalist Theme
---

<div class="w-full bg-white text-neutral-900 border-b border-neutral-200">
  <!-- Rotating Top Announcement Bar (White Background) -->
  <div class="py-2.5 px-4 text-center text-[11px] tracking-[0.2em] font-medium uppercase relative overflow-hidden bg-white text-neutral-900 flex items-center justify-center min-h-[36px] border-b border-neutral-100">
    <div id="announcement-slider" class="transition-opacity duration-500 text-neutral-800 font-semibold">
      <span class="announcement-item block transition-all duration-700">HASSLE-FREE RETURNS — 30-DAY POSTAGE PAID RETURNS</span>
      <span class="announcement-item hidden transition-all duration-700">COMPLIMENTARY EXPRESS SHIPPING OVER $150</span>
      <span class="announcement-item hidden transition-all duration-700">SUSTAINABLY SOURCED LINEN & ARTISAN TAILORING</span>
    </div>
  </div>

  <!-- Secondary Utility Bar (Light Cream / White Background) -->
  <div class="hidden md:flex justify-between items-center px-6 lg:px-12 py-2 text-[12px] bg-[#FAF8F5] text-neutral-600 border-b border-neutral-200/80">
    <!-- Left: Utility Links -->
    <div class="flex items-center space-x-6 tracking-wider">
      <a href="#about" class="hover:text-black transition-colors duration-200">Sustainability</a>
      <span class="text-neutral-300">|</span>
      <a href="#care" class="hover:text-black transition-colors duration-200">Garment Care</a>
      <span class="text-neutral-300">|</span>
      <a href="#stores" class="hover:text-black transition-colors duration-200">Find a Store</a>
      <span class="text-neutral-300">|</span>
      <a href="#care" class="hover:text-black transition-colors duration-200">Customer Care</a>
    </div>

    <!-- Right: Social Links & Currency Selector -->
    <div class="flex items-center space-x-6">
      <!-- Social Media Icons -->
      <div class="flex items-center space-x-4 text-neutral-700">
        <!-- Instagram -->
        <a href="https://instagram.com" target="_blank" rel="noopener" class="hover:text-black transition-colors duration-200" title="Instagram">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <!-- Facebook -->
        <a href="https://facebook.com" target="_blank" rel="noopener" class="hover:text-black transition-colors duration-200" title="Facebook">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
        </a>
        <!-- Pinterest -->
        <a href="https://pinterest.com" target="_blank" rel="noopener" class="hover:text-black transition-colors duration-200" title="Pinterest">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.334 1.357-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 12-5.373 12-12 0-6.628-5.393-12-12-12z"/></svg>
        </a>
        <!-- TikTok -->
        <a href="https://tiktok.com" target="_blank" rel="noopener" class="hover:text-black transition-colors duration-200" title="TikTok">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.18 1.19 2.12 2.38 2.36.95.2 1.96.06 2.76-.47.66-.43 1.12-1.12 1.25-1.9.07-.76.04-1.53.04-2.3V.02z"/></svg>
        </a>
      </div>

      <!-- Currency Selector -->
      <div class="flex items-center space-x-1 cursor-pointer text-neutral-700 hover:text-black">
        <span>Indonesia (USD $)</span>
        <svg class="w-3 h-3 ml-1 fill-current opacity-70" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Announcement Auto-Rotator
  (function() {
    let currentIndex = 0;
    const items = document.querySelectorAll('#announcement-slider .announcement-item');
    if (items.length > 1) {
      setInterval(() => {
        items[currentIndex].classList.add('hidden');
        currentIndex = (currentIndex + 1) % items.length;
        items[currentIndex].classList.remove('hidden');
      }, 3500);
    }
  })();
</script>
