---
// Impulse Utility Bar Component - Clean White Minimalist Theme
---

<div class="w-full bg-[#FAF8F5] text-neutral-800 border-b border-neutral-200/70">
  <!-- Rotating Top Announcement Bar (Clean & Minimalist) -->
  <div class="py-2 px-4 text-center text-[10px] sm:text-[11px] tracking-[0.2em] font-medium uppercase relative overflow-hidden flex items-center justify-center min-h-[32px]">
    <div id="announcement-slider" class="transition-opacity duration-500 text-neutral-700 font-medium">
      <span class="announcement-item block transition-all duration-700">COMPLIMENTARY SHIPPING &bull; PENGIRIMAN KE SELURUH INDONESIA</span>
      <span class="announcement-item hidden transition-all duration-700">TIMELESS SILHOUETTES &bull; ARTISAN CRAFTSMANSHIP</span>
      <span class="announcement-item hidden transition-all duration-700">EXCLUSIVE EDITORIAL COLLECTION &bull; SHOP ONLINE</span>
    </div>
  </div>
</div>

<script is:inline>
  // Announcement Auto-Rotator
  (function() {
    let currentIndex = 0;
    const items = document.querySelectorAll('#announcement-slider .announcement-item');
    if (items.length > 1) {
      setInterval(() => {
        items[currentIndex].classList.add('hidden');
        currentIndex = (currentIndex + 1) % items.length;
        items[currentIndex].classList.remove('hidden');
      }, 3500);
    }
  })();
</script>
