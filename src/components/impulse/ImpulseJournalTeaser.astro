---
// Journal / Blog Teaser (2 Columns)
---

<section id="journal" class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12 max-w-[1400px] mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Left Column: Editorial Text & CTA -->
    <div class="lg:col-span-5 text-left">
      <span class="text-[11px] tracking-[0.25em] uppercase font-semibold text-neutral-500 block mb-3">
        Stories &amp; Seasonality
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light text-neutral-900 leading-tight">
        Inside the journal
      </h2>
      <p class="mt-5 text-neutral-600 font-light text-sm sm:text-base leading-relaxed">
        Explore styling ideas, seasonal notes, and content-rich stories that bring our collections to life. From our artisan mills in Portugal to slow morning rituals.
      </p>

      <div class="mt-8 flex items-center space-x-6">
        <a
          href="/blog"
          class="inline-block bg-black text-white hover:bg-neutral-800 px-8 py-3.5 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 shadow-md hover:shadow-lg"
        >
          READ MORE
        </a>
        <a
          href="/blog"
          class="text-xs tracking-[0.15em] uppercase font-semibold text-neutral-800 hover:text-black border-b border-neutral-300 pb-0.5 transition-all"
        >
          View All Issues (08)
        </a>
      </div>
    </div>

    <!-- Right Column: Asymmetric Layered Images / Collage -->
    <div class="lg:col-span-7 relative flex items-center justify-center lg:justify-end">
      <!-- Main Large Photo (Linen texture / Flat-lay) -->
      <div class="relative w-4/5 sm:w-3/4 aspect-[4/5] overflow-hidden rounded-sm bg-[#EFECE6] shadow-xl">
        <img
          src="https://images.unsplash.com/photo-1528459801416-a9e53bbf4e17?q=80&w=800&auto=format&fit=crop"
          alt="Linen texture detail"
          class="w-full h-full object-cover object-center transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
      </div>

      <!-- Overlapping Smaller Flat-lay Card -->
      <div class="absolute -bottom-6 -left-2 sm:left-4 w-1/2 sm:w-2/5 aspect-[3/4] overflow-hidden rounded-sm bg-white p-2 shadow-2xl border border-neutral-100">
        <img
          src="https://images.unsplash.com/photo-1445205170230-053b83016050?q=80&w=600&auto=format&fit=crop"
          alt="Natural linen fashion accessories"
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-x-4 bottom-4 bg-white/90 backdrop-blur-sm p-2 text-center rounded">
          <span class="text-[10px] tracking-widest uppercase font-bold text-neutral-800">Issue 04: The Natural Edit</span>
        </div>
      </div>
    </div>

  </div>
</section>
