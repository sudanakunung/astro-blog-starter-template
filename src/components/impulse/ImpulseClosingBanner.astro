---
// Full-width Closing Banner with Warm Golden Hour Light
---

<section class="relative w-full overflow-hidden bg-[#2D2A26] my-10 sm:my-16">
  <div class="relative w-full h-[60vh] min-h-[460px] max-h-[700px]">
    <!-- Golden Hour Close-up Model Photo -->
    <img
      src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?q=80&w=2000&auto=format&fit=crop"
      alt="Easy to wear, easy to return to - Golden Hour Collection"
      class="w-full h-full object-cover object-center brightness-[0.88]"
      loading="lazy"
    />

    <!-- Warm Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900/60 via-stone-900/20 to-stone-900/40"></div>

    <!-- Center Overlay Text -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6 max-w-3xl mx-auto text-white z-10">
      <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light tracking-wide leading-tight drop-shadow-md">
        Easy to wear, easy to return to
      </h2>
      <p class="mt-4 text-xs sm:text-base text-neutral-200 font-light max-w-lg leading-relaxed drop-shadow">
        Soft shapes and understated details for everyday dressing and smaller occasions.
      </p>
      <div class="mt-8">
        <a
          href="#catalog"
          class="inline-block border border-white text-white hover:bg-white hover:text-black px-8 py-3.5 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 shadow-xl transform hover:scale-105"
        >
          SHOP DRESSES
        </a>
      </div>
    </div>
  </div>
</section>
