---
// Impulse Hero Section with Shoppable Hotspots
---

<section class="relative w-full overflow-hidden bg-[#F5F2EB]">
  <!-- Hero Background Image (Lifestyle Fashion with warm natural light) -->
  <div class="relative w-full h-[75vh] min-h-[580px] max-h-[860px]">
    <img
      src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop"
      alt="Impulse Women Fashion Collection - Easy by Design"
      class="w-full h-full object-cover object-center brightness-[0.96]"
      loading="eager"
    />

    <!-- Subtle Vignette / Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent"></div>
    <div class="absolute inset-0 bg-stone-900/10 mix-blend-multiply"></div>

    <!-- ============================================================ -->
    <!-- SHOPPABLE HOTSPOTS (+) -->
    <!-- ============================================================ -->
    
    <!-- Hotspot 1: White Linen Blouse (Left Model) -->
    <div class="absolute top-[38%] left-[22%] sm:left-[28%] z-20 group">
      <button
        class="hotspot-trigger w-8 h-8 rounded-full bg-white/90 hover:bg-white text-black shadow-lg flex items-center justify-center transition-all duration-300 transform group-hover:scale-110 focus:outline-none ring-4 ring-white/30 animate-pulse"
        aria-label="View The Arden Linen Blouse"
      >
        <span class="text-base font-bold leading-none">+</span>
      </button>

      <!-- Hotspot Tooltip / Popover Card -->
      <div class="opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-300 absolute left-10 -top-12 z-30 w-64 bg-white/95 backdrop-blur-md p-3 rounded-lg shadow-2xl border border-neutral-200 pointer-events-auto">
        <div class="flex space-x-3 items-center">
          <img
            src="https://images.unsplash.com/photo-1598554747436-c9293d6a588f?q=80&w=200&auto=format&fit=crop"
            alt="The Arden Linen Blouse"
            class="w-14 h-18 object-cover rounded bg-neutral-100"
          />
          <div class="flex-1 text-left">
            <h4 class="text-xs font-serif font-bold text-neutral-900 leading-tight">The Arden Co-ord</h4>
            <p class="text-[11px] text-neutral-500 mt-0.5">Airy pure linen</p>
            <p class="text-xs font-semibold text-neutral-900 mt-1">$214</p>
            <button
              class="quick-add-btn mt-2 text-[10px] tracking-wider uppercase font-bold text-white bg-black hover:bg-neutral-800 px-3 py-1 rounded-full w-full transition-colors"
              data-id="impulse-hero-1"
              data-name="The Arden Co-ord"
              data-price="214"
              data-image="https://images.unsplash.com/photo-1598554747436-c9293d6a588f?q=80&w=400&auto=format&fit=crop"
            >
              + Quick Add
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Hotspot 2: Sage Green Dress (Center Model) -->
    <div class="absolute top-[48%] left-[50%] z-20 group -translate-x-1/2">
      <button
        class="hotspot-trigger w-8 h-8 rounded-full bg-white/90 hover:bg-white text-black shadow-lg flex items-center justify-center transition-all duration-300 transform group-hover:scale-110 focus:outline-none ring-4 ring-white/30 animate-pulse"
        aria-label="View The Cove Flowy Dress"
      >
        <span class="text-base font-bold leading-none">+</span>
      </button>

      <!-- Popover Card -->
      <div class="opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-300 absolute left-1/2 -translate-x-1/2 -top-28 z-30 w-64 bg-white/95 backdrop-blur-md p-3 rounded-lg shadow-2xl border border-neutral-200 pointer-events-auto">
        <div class="flex space-x-3 items-center">
          <img
            src="https://images.unsplash.com/photo-1515372039744-b8f02a3ae446?q=80&w=200&auto=format&fit=crop"
            alt="The Cove Flowy Dress"
            class="w-14 h-18 object-cover rounded bg-neutral-100"
          />
          <div class="flex-1 text-left">
            <span class="inline-block text-[9px] bg-black text-white px-1.5 py-0.5 rounded font-bold uppercase mb-1">New</span>
            <h4 class="text-xs font-serif font-bold text-neutral-900 leading-tight">The Cove Midi Dress</h4>
            <p class="text-[11px] text-neutral-500 mt-0.5">Sage washed cotton</p>
            <p class="text-xs font-semibold text-neutral-900 mt-1">$112</p>
            <button
              class="quick-add-btn mt-2 text-[10px] tracking-wider uppercase font-bold text-white bg-black hover:bg-neutral-800 px-3 py-1 rounded-full w-full transition-colors"
              data-id="impulse-hero-2"
              data-name="The Cove Midi Dress"
              data-price="112"
              data-image="https://images.unsplash.com/photo-1515372039744-b8f02a3ae446?q=80&w=400&auto=format&fit=crop"
            >
              + Quick Add
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Hotspot 3: Relaxed Linen Overshirt (Right Model) -->
    <div class="absolute top-[35%] right-[20%] sm:right-[26%] z-20 group">
      <button
        class="hotspot-trigger w-8 h-8 rounded-full bg-white/90 hover:bg-white text-black shadow-lg flex items-center justify-center transition-all duration-300 transform group-hover:scale-110 focus:outline-none ring-4 ring-white/30 animate-pulse"
        aria-label="View The Brisa Overshirt"
      >
        <span class="text-base font-bold leading-none">+</span>
      </button>

      <!-- Popover Card -->
      <div class="opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-300 absolute right-10 -top-12 z-30 w-64 bg-white/95 backdrop-blur-md p-3 rounded-lg shadow-2xl border border-neutral-200 pointer-events-auto">
        <div class="flex space-x-3 items-center">
          <img
            src="https://images.unsplash.com/photo-1554412933-514a83d2f3c8?q=80&w=200&auto=format&fit=crop"
            alt="The Brisa Overshirt"
            class="w-14 h-18 object-cover rounded bg-neutral-100"
          />
          <div class="flex-1 text-left">
            <h4 class="text-xs font-serif font-bold text-neutral-900 leading-tight">The Brisa Overshirt</h4>
            <p class="text-[11px] text-neutral-500 mt-0.5">Warm oat tailored</p>
            <p class="text-xs font-semibold text-neutral-900 mt-1">$132</p>
            <button
              class="quick-add-btn mt-2 text-[10px] tracking-wider uppercase font-bold text-white bg-black hover:bg-neutral-800 px-3 py-1 rounded-full w-full transition-colors"
              data-id="impulse-hero-3"
              data-name="The Brisa Overshirt"
              data-price="132"
              data-image="https://images.unsplash.com/photo-1554412933-514a83d2f3c8?q=80&w=400&auto=format&fit=crop"
            >
              + Quick Add
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- OVERLAY TEXT (Bottom Left Editorial Box) -->
    <!-- ============================================================ -->
    <div class="absolute bottom-10 left-6 sm:bottom-16 sm:left-12 lg:left-20 z-20 max-w-xl text-left text-white">
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light tracking-wide leading-tight drop-shadow-md">
        Easy by design
      </h1>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-neutral-100 font-light max-w-md leading-relaxed drop-shadow">
        Soft texture, effortless movement, warm-weather pieces designed to be worn on repeat.
      </p>
      <div class="mt-6 sm:mt-8">
        <a
          href="#catalog"
          class="inline-block bg-black text-white hover:bg-neutral-900 px-8 py-3.5 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 transform hover:-translate-y-0.5 shadow-xl hover:shadow-2xl border border-white/20"
        >
          SHOP LINEN
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Setup quick add listeners on hotspots
  document.querySelectorAll('.quick-add-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.id;
      const name = btn.dataset.name;
      const price = parseInt(btn.dataset.price, 10);
      const image = btn.dataset.image;

      let cart = [];
      try { cart = JSON.parse(localStorage.getItem('cart') || '[]'); } catch(err) {}
      const existing = cart.find(item => item.id === id);
      if (existing) {
        existing.qty = (existing.qty || 1) + 1;
      } else {
        cart.push({ id, name, price, qty: 1, image });
      }
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart-updated'));

      // Trigger Toast
      if (window.showToast) {
        window.showToast(`Added ${name} to your cart.`);
      }

      // Open Cart Drawer
      const drawer = document.getElementById('cart-drawer');
      if (drawer) drawer.classList.remove('hidden');
    });
  });
</script>
