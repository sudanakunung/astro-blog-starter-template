---
// Value Proposition (3 Columns with Minimal Line Icons)
const values = [
  {
    title: 'Quietly considered',
    description: 'Understated details that bring polish without asking for attention.',
    icon: 'heart',
  },
  {
    title: 'Texture you can feel',
    description: 'From airy linen to soft knits, each fabric adds warmth, ease, and depth.',
    icon: 'texture',
  },
  {
    title: 'Made for repeat wear',
    description: 'Simple pieces, thoughtful layers, and a wardrobe that feels natural to come back to.',
    icon: 'repeat',
  },
];
---

<section class="py-16 sm:py-20 px-6 sm:px-12 bg-[#F9F7F2] border-t border-b border-neutral-200/70">
  <div class="max-w-[1300px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 text-center">
    {values.map((v) => (
      <div class="flex flex-col items-center px-4">
        <!-- Minimal Thin Line Icon -->
        <div class="w-12 h-12 mb-5 rounded-full bg-white flex items-center justify-center text-neutral-800 shadow-sm border border-neutral-200">
          {v.icon === 'heart' && (
            <svg class="w-5 h-5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          )}
          {v.icon === 'texture' && (
            <svg class="w-5 h-5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          )}
          {v.icon === 'repeat' && (
            <svg class="w-5 h-5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          )}
        </div>

        <h3 class="font-serif text-xl sm:text-2xl font-normal text-neutral-900 mb-2.5">
          {v.title}
        </h3>
        <p class="text-xs sm:text-sm text-neutral-600 font-light leading-relaxed max-w-xs">
          {v.description}
        </p>
      </div>
    ))}
  </div>
</section>
