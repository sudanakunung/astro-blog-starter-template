---
export interface ImpulseProduct {
  id: string;
  name: string;
  price: number;
  originalPrice?: number;
  badge?: 'Sale' | 'New';
  image1: string;
  image2: string;
  colors?: string[];
  description?: string;
}

interface Props {
  title: string;
  viewAllLink?: string;
  products?: ImpulseProduct[];
  sectionId?: string;
}

const {
  title = 'Everyday Essentials',
  viewAllLink = '#catalog',
  products = [],
  sectionId = 'catalog',
} = Astro.props;
---

<section id={sectionId} class="py-10 sm:py-16 px-3 sm:px-8 lg:px-12 max-w-[1500px] mx-auto border-t border-gray-100">
  <!-- Section Header -->
  <div class="flex items-baseline justify-between mb-6 sm:mb-10 px-1">
    <h2 class="font-serif text-xl sm:text-3xl font-light tracking-wide text-neutral-900">
      {title}
    </h2>
    <a
      href={viewAllLink}
      class="text-[11px] sm:text-xs tracking-[0.2em] uppercase font-semibold text-neutral-800 hover:text-black border-b border-neutral-300 hover:border-black pb-0.5 transition-all"
    >
      VIEW ALL
    </a>
  </div>

  <!-- 2-Column on Mobile, 3-Column on Tablet, 5-Column on Desktop -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-6">
    {products.map((p) => {
      const isSale = p.badge === 'Sale' && p.originalPrice && p.originalPrice > p.price;
      const savings = isSale ? (p.originalPrice! - p.price) : 0;

      return (
        <div class="group relative flex flex-col justify-between bg-transparent">
          <!-- Image Box with 3:4 Portrait Ratio & Hover Swap -->
          <div
            class="relative w-full overflow-hidden bg-stone-100 rounded-sm cursor-pointer"
            style="aspect-ratio: 3/4; position: relative;"
          >
            <!-- Primary Image -->
            <img
              src={p.image1}
              alt={p.name}
              class="w-full h-full object-cover object-center transition-opacity duration-500 group-hover:opacity-0"
              style="object-fit: cover; width: 100%; height: 100%;"
              loading="lazy"
            />
            <!-- Secondary Image (Hover Swap) -->
            <img
              src={p.image2 || p.image1}
              alt={`${p.name} detail`}
              class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-500 group-hover:opacity-100 scale-100 group-hover:scale-105 transition-transform duration-700"
              style="object-fit: cover; width: 100%; height: 100%;"
              loading="lazy"
            />

            <!-- Badges -->
            {p.badge && (
              <div class="absolute top-2 left-2 z-10">
                <span
                  class={`px-2 py-0.5 text-[9px] sm:text-[10px] tracking-wider uppercase font-bold rounded-sm ${
                    p.badge === 'Sale'
                      ? 'bg-red-500 text-white'
                      : 'bg-black text-white'
                  }`}
                  style={p.badge === 'Sale' ? 'background-color: #D98270 !important;' : 'background-color: #000000 !important;'}
                >
                  {p.badge}
                </span>
              </div>
            )}

            <!-- Quick View Button (desktop hover or mobile tap) -->
            <div class="hidden sm:block absolute inset-x-3 bottom-3 z-10 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <button
                type="button"
                class="quick-view-trigger w-full bg-white text-black hover:bg-black hover:text-white py-2 text-[10px] sm:text-[11px] font-bold tracking-widest uppercase rounded shadow transition-colors"
                style="background-color: #ffffff; color: #000000;"
                data-id={p.id}
                data-name={p.name}
                data-price={p.price}
                data-origprice={p.originalPrice || ''}
                data-badge={p.badge || ''}
                data-image={p.image1}
                data-image2={p.image2}
                data-desc={p.description || 'Crafted with premium natural fiber and tailored with minimal timeless cuts.'}
              >
                Quick View
              </button>
            </div>
          </div>

          <!-- Product Details -->
          <div class="pt-2.5 sm:pt-3 text-left">
            <h3 class="text-xs sm:text-sm font-normal text-neutral-900 group-hover:text-neutral-600 transition-colors line-clamp-1">
              {p.name}
            </h3>

            <!-- Price Block -->
            <div class="mt-1 flex flex-wrap items-center gap-1.5 text-xs sm:text-[13px]">
              {isSale ? (
                <>
                  <span class="text-neutral-400 line-through text-[11px] sm:text-xs">
                    {p.originalPrice! >= 1000 ? `Rp ${p.originalPrice!.toLocaleString('id-ID')}` : `$${p.originalPrice}`}
                  </span>
                  <span class="font-semibold text-rose-700">
                    {p.price >= 1000 ? `Rp ${p.price.toLocaleString('id-ID')}` : `$${p.price}`}
                  </span>
                  <span class="text-[10px] sm:text-[11px] text-amber-700 font-medium" style="color: #c26955;">
                    (Hemat {savings >= 1000 ? `Rp ${savings.toLocaleString('id-ID')}` : `$${savings}`})
                  </span>
                </>
              ) : (
                <span class="font-medium text-neutral-900">
                  {p.price >= 1000 ? `Rp ${p.price.toLocaleString('id-ID')}` : `$${p.price}`}
                </span>
              )}
            </div>

            <!-- Quick Add to Cart Link -->
            <div class="mt-2">
              <button
                type="button"
                class="direct-add-btn text-[10px] sm:text-[11px] tracking-widest uppercase font-semibold text-neutral-600 hover:text-black flex items-center space-x-1 group/btn py-0.5"
                data-id={p.id}
                data-name={p.name}
                data-price={p.price}
                data-image={p.image1}
              >
                <span>+ Add to Bag</span>
                <span class="opacity-0 group-hover/btn:opacity-100 transform -translate-x-1 group-hover/btn:translate-x-0 transition-all hidden sm:inline">→</span>
              </button>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script is:inline>
  // Handle direct Add to Bag buttons
  document.querySelectorAll('.direct-add-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.id;
      const name = btn.dataset.name;
      const price = parseInt(btn.dataset.price, 10);
      const image = btn.dataset.image;

      if (window.NordicCart) {
        window.NordicCart.addItem({
          id,
          name,
          price,
          image,
          slug: id,
        }, 1);
      }
    });
  });
</script>
