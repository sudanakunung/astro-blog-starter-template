---
export interface ImpulseProduct {
  id: string;
  name: string;
  price: number;
  originalPrice?: number;
  badge?: 'Sale' | 'New';
  image1: string;
  image2: string;
  colors?: string[];
  description?: string;
}

interface Props {
  title: string;
  viewAllLink?: string;
  products?: ImpulseProduct[];
  sectionId?: string;
}

const {
  title = 'Everyday Essentials',
  viewAllLink = '#catalog',
  products = [],
  sectionId = 'catalog',
} = Astro.props;
---

<section id={sectionId} class="py-12 sm:py-16 px-4 sm:px-8 lg:px-12 max-w-[1500px] mx-auto border-t border-neutral-100">
  <!-- Section Header -->
  <div class="flex items-baseline justify-between mb-8 sm:mb-10">
    <h2 class="font-serif text-2xl sm:text-3xl font-light tracking-wide text-neutral-900">
      {title}
    </h2>
    <a
      href={viewAllLink}
      class="text-[11px] sm:text-xs tracking-[0.2em] uppercase font-semibold text-neutral-800 hover:text-black border-b border-neutral-300 hover:border-black pb-0.5 transition-all"
    >
      VIEW ALL
    </a>
  </div>

  <!-- 5-Column Grid / Mobile Horizontal Carousel -->
  <div class="flex sm:grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 overflow-x-auto sm:overflow-x-visible pb-4 sm:pb-0 scrollbar-none snap-x">
    {products.map((p) => {
      const isSale = p.badge === 'Sale' && p.originalPrice && p.originalPrice > p.price;
      const savings = isSale ? (p.originalPrice! - p.price) : 0;

      return (
        <div class="min-w-[220px] sm:min-w-0 flex-shrink-0 snap-start group relative flex flex-col justify-between">
          <!-- Image Box with Hover Swap -->
          <div class="relative aspect-[3/4] w-full overflow-hidden bg-[#F2EFE9] rounded-sm cursor-pointer">
            <!-- Primary Image -->
            <img
              src={p.image1}
              alt={p.name}
              class="w-full h-full object-cover object-center transition-opacity duration-500 group-hover:opacity-0"
              loading="lazy"
            />
            <!-- Secondary Image (Hover Swap) -->
            <img
              src={p.image2 || p.image1}
              alt={`${p.name} detail`}
              class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-500 group-hover:opacity-100 scale-100 group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />

            <!-- Badges -->
            {p.badge && (
              <div class="absolute top-2.5 left-2.5 z-10">
                <span
                  class={`px-2.5 py-1 text-[10px] tracking-wider uppercase font-bold rounded-sm ${
                    p.badge === 'Sale'
                      ? 'bg-[#D98270] text-white'
                      : 'bg-black text-white'
                  }`}
                >
                  {p.badge}
                </span>
              </div>
            )}

            <!-- Quick View Button (appears on hover) -->
            <div class="absolute inset-x-3 bottom-3 z-10 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <button
                type="button"
                class="quick-view-trigger w-full bg-white/95 backdrop-blur text-black hover:bg-black hover:text-white py-2 text-[11px] font-bold tracking-widest uppercase rounded shadow transition-colors"
                data-id={p.id}
                data-name={p.name}
                data-price={p.price}
                data-origprice={p.originalPrice || ''}
                data-badge={p.badge || ''}
                data-image={p.image1}
                data-image2={p.image2}
                data-desc={p.description || 'Crafted with premium natural fiber and tailored with minimal timeless cuts.'}
              >
                Quick View
              </button>
            </div>
          </div>

          <!-- Product Details -->
          <div class="pt-3 text-left">
            <h3 class="text-sm font-normal text-neutral-900 group-hover:text-neutral-600 transition-colors">
              {p.name}
            </h3>

            <!-- Price Block -->
            <div class="mt-1 flex items-center space-x-2 text-[13px]">
              {isSale ? (
                <>
                  <span class="text-neutral-400 line-through">${p.originalPrice}</span>
                  <span class="font-medium text-rose-700">${p.price}</span>
                  <span class="text-[11px] text-[#D98270] font-medium">(Save ${savings})</span>
                </>
              ) : (
                <span class="font-medium text-neutral-900">${p.price}</span>
              )}
            </div>

            <!-- Quick Add to Cart Link -->
            <div class="mt-2">
              <button
                type="button"
                class="direct-add-btn text-[11px] tracking-widest uppercase font-semibold text-neutral-600 hover:text-black flex items-center space-x-1 group/btn"
                data-id={p.id}
                data-name={p.name}
                data-price={p.price}
                data-image={p.image1}
              >
                <span>+ Add to Bag</span>
                <span class="opacity-0 group-hover/btn:opacity-100 transform -translate-x-1 group-hover/btn:translate-x-0 transition-all">→</span>
              </button>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script is:inline>
  // Handle direct Add to Bag buttons
  document.querySelectorAll('.direct-add-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.id;
      const name = btn.dataset.name;
      const price = parseInt(btn.dataset.price, 10);
      const image = btn.dataset.image;

      let cart = [];
      try { cart = JSON.parse(localStorage.getItem('cart') || '[]'); } catch(err) {}
      const existing = cart.find(item => item.id === id);
      if (existing) {
        existing.qty = (existing.qty || 1) + 1;
      } else {
        cart.push({ id, name, price, qty: 1, image });
      }
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart-updated'));

      if (window.showToast) {
        window.showToast(`Added ${name} to bag.`);
      }

      const drawer = document.getElementById('cart-drawer');
      if (drawer) drawer.classList.remove('hidden');
    });
  });
</script>
