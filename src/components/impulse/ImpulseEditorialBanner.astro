---
interface Props {
  mediaUrl?: string;
}

const { mediaUrl } = Astro.props;

function isVideoUrl(url?: string): boolean {
  if (!url) return false;
  const clean = url.split('?')[0].toLowerCase();
  return clean.endsWith('.mp4') || clean.endsWith('.webm') || clean.endsWith('.mov') || clean.endsWith('.ogg') || clean.endsWith('.mkv');
}

const src = mediaUrl || 'https://images.unsplash.com/photo-1502716119720-b23a93e5fe1b?q=80&w=2000&auto=format&fit=crop';
const isVideo = isVideoUrl(src);
---

<section id="lookbook" class="relative w-full my-12 sm:my-18 overflow-hidden bg-neutral-900">
  <div class="relative w-full h-[65vh] min-h-[500px] max-h-[750px]">
    <!-- Editorial Fashion Movement Image or Video -->
    {isVideo ? (
      <video
        src={src}
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-cover object-center brightness-[0.85] contrast-[1.05]"
      ></video>
    ) : (
      <img
        src={src}
        alt="Made to move with ease - The Lookbook"
        class="w-full h-full object-cover object-center brightness-[0.85] contrast-[1.05]"
        loading="lazy"
      />
    )}

    <!-- Ambient Overlay -->
    <div class="absolute inset-0 bg-stone-900/35 backdrop-brightness-95"></div>

    <!-- Center Overlay Text -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6 max-w-3xl mx-auto text-white z-10">
      <span class="text-[11px] tracking-[0.3em] uppercase text-neutral-300 font-semibold mb-3">
        Summer 2026 Lookbook
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light tracking-wide leading-tight drop-shadow-md">
        Made to move with ease
      </h2>
      <p class="mt-4 text-xs sm:text-base text-neutral-200 font-light max-w-lg leading-relaxed drop-shadow">
        Quiet texture, warm light, and pieces designed for slower days.
      </p>
      <div class="mt-8">
        <a
          href="#collections"
          class="inline-block border border-white text-white hover:bg-white hover:text-black px-8 py-3.5 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 shadow-xl transform hover:scale-105"
        >
          EXPLORE THE LOOKBOOK
        </a>
      </div>
    </div>
  </div>
</section>
