---
// Promo Banner 2 Columns (50/50 Split)
---

<section class="w-full my-8 sm:my-14">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-2 sm:gap-4 px-2 sm:px-6 max-w-[1700px] mx-auto">
    
    <!-- Left Banner: Dresses for Every Day -->
    <div class="relative h-[480px] sm:h-[600px] lg:h-[680px] overflow-hidden group bg-stone-100">
      <img
        src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop"
        alt="Dresses for every day"
        class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover:scale-105"
        loading="lazy"
      />
      <!-- Subtle Dark Overlay -->
      <div class="absolute inset-0 bg-black/25 group-hover:bg-black/20 transition-colors duration-300"></div>

      <!-- Text Content (Bottom Center/Left) -->
      <div class="absolute inset-x-6 bottom-10 sm:inset-x-12 sm:bottom-14 text-white text-center sm:text-left z-10 max-w-lg">
        <h3 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide leading-tight drop-shadow">
          Dresses for every day
        </h3>
        <p class="mt-3 text-xs sm:text-sm text-neutral-100 font-light leading-relaxed drop-shadow">
          Easy silhouettes for slow mornings, summer dinners, and everything in between.
        </p>
        <div class="mt-6">
          <a
            href="#catalog"
            class="inline-block bg-black text-white hover:bg-neutral-900 px-7 py-3 rounded-full text-[11px] font-bold tracking-[0.2em] uppercase transition-all duration-300 transform hover:-translate-y-0.5 border border-white/20 shadow-lg"
          >
            SHOP DRESSES
          </a>
        </div>
      </div>
    </div>

    <!-- Right Banner: Thoughtful Layers -->
    <div class="relative h-[480px] sm:h-[600px] lg:h-[680px] overflow-hidden group bg-stone-100">
      <img
        src="https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1000&auto=format&fit=crop"
        alt="Thoughtful layers"
        class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover:scale-105"
        loading="lazy"
      />
      <!-- Subtle Dark Overlay -->
      <div class="absolute inset-0 bg-black/25 group-hover:bg-black/20 transition-colors duration-300"></div>

      <!-- Text Content -->
      <div class="absolute inset-x-6 bottom-10 sm:inset-x-12 sm:bottom-14 text-white text-center sm:text-left z-10 max-w-lg">
        <h3 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide leading-tight drop-shadow">
          Thoughtful layers
        </h3>
        <p class="mt-3 text-xs sm:text-sm text-neutral-100 font-light leading-relaxed drop-shadow">
          Soft knits, relaxed tailoring, and lightweight pieces to throw on and go.
        </p>
        <div class="mt-6">
          <a
            href="#catalog"
            class="inline-block bg-black text-white hover:bg-neutral-900 px-7 py-3 rounded-full text-[11px] font-bold tracking-[0.2em] uppercase transition-all duration-300 transform hover:-translate-y-0.5 border border-white/20 shadow-lg"
          >
            SHOP LAYERS
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
